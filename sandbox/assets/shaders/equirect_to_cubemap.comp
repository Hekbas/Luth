#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D equirectMap;
layout(rgba16f, set = 0, binding = 1) writeonly uniform image2DArray cubemapOut;

const float PI = 3.14159265359;

// Get cubemap direction from face index and UV
vec3 GetCubemapDirection(uint face, vec2 uv)
{
    // Remap UV from [0,1] to [-1,1]
    vec2 st = uv * 2.0 - 1.0;

    switch (face)
    {
        case 0: return normalize(vec3( 1.0, -st.y, -st.x)); // +X
        case 1: return normalize(vec3(-1.0, -st.y,  st.x)); // -X
        case 2: return normalize(vec3( st.x,  1.0,  st.y)); // +Y
        case 3: return normalize(vec3( st.x, -1.0, -st.y)); // -Y
        case 4: return normalize(vec3( st.x, -st.y,  1.0)); // +Z
        case 5: return normalize(vec3(-st.x, -st.y, -1.0)); // -Z
    }
    return vec3(0.0);
}

// Convert direction to equirectangular UV
vec2 DirectionToEquirect(vec3 dir)
{
    float phi = atan(dir.z, dir.x);     // [-PI, PI]
    float theta = asin(clamp(dir.y, -1.0, 1.0)); // [-PI/2, PI/2]

    vec2 uv;
    uv.x = phi / (2.0 * PI) + 0.5;     // [0, 1]
    uv.y = theta / PI + 0.5;           // [0, 1]
    return uv;
}

void main()
{
    ivec3 texCoord = ivec3(gl_GlobalInvocationID.xyz);
    ivec2 texSize = imageSize(cubemapOut).xy;

    if (texCoord.x >= texSize.x || texCoord.y >= texSize.y || texCoord.z >= 6)
        return;

    vec2 uv = (vec2(texCoord.xy) + 0.5) / vec2(texSize);
    vec3 dir = GetCubemapDirection(texCoord.z, uv);
    vec2 equirectUV = DirectionToEquirect(dir);

    vec3 color = texture(equirectMap, equirectUV).rgb;
    imageStore(cubemapOut, texCoord, vec4(color, 1.0));
}
