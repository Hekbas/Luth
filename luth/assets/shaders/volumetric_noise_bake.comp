#version 450

// One-shot noise bake — writes a tile-able 128³ RGBA8 3D texture used by the volumetric inject
// pass to add fog-density variation ("wispy" / cloudy look). Run once at VolumetricSubsystem::Init
// via ImmediateSubmit; the texture lives for the engine's lifetime.
//
// Channel layout:
//   R = low-frequency cloud structure   (Worley FBM, large blobs)
//   G = high-frequency detail            (single-octave Worley, fine wisps)
//   B = mid-frequency layer              (FBM at intermediate scale, swirly look)
//   A = combined "ready-to-use"          (R + B − G's edge-emphasis, remapped to 0..1)
//
// The inject shader typically samples .a for the default look; .rgb is exposed so future shader
// tweaks can mix channels without re-baking.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D u_NoiseOut;

layout(push_constant) uniform PC {
    uint dim;   // 128 (atlas-side constant; PC keeps the shader resolution-agnostic)
} pc;

// Cheap hash → unit cube. Same shape used by demoscene tutorials; tunable seed in the dot products.
vec3 hash33(vec3 p)
{
    p = vec3(dot(p, vec3(127.1, 311.7, 74.7)),
             dot(p, vec3(269.5, 183.3, 246.1)),
             dot(p, vec3(113.5, 271.9, 124.6)));
    return fract(sin(p) * 43758.5453);
}

// Tile-able Worley by wrapping the integer cell coords modulo the tile dim before hashing.
float Worley3DTileable(vec3 uvw, float cells)
{
    vec3 p  = uvw * cells;
    vec3 ip = floor(p);
    vec3 fp = fract(p);
    float minDist2 = 1e6;
    for (int z = -1; z <= 1; ++z)
    for (int y = -1; y <= 1; ++y)
    for (int x = -1; x <= 1; ++x)
    {
        vec3 cell    = ip + vec3(x, y, z);
        vec3 wrapped = mod(cell, vec3(cells));
        vec3 featPos = vec3(x, y, z) + hash33(wrapped);
        vec3 r       = featPos - fp;
        minDist2     = min(minDist2, dot(r, r));
    }
    return clamp(sqrt(minDist2), 0.0, 1.0);
}

// Inverted Worley — high values inside cells, low at edges. Better fog match (cells = clumps).
float WorleyInv(vec3 uvw, float cells)
{
    return 1.0 - Worley3DTileable(uvw, cells);
}

// FBM Worley — sum at multiple octaves, decreasing amplitude. Cells per octave doubles per step.
float WorleyFBM(vec3 uvw, float baseCells)
{
    float w = 0.0;
    float amp = 0.625;
    float cells = baseCells;
    for (int i = 0; i < 3; ++i)
    {
        w     += WorleyInv(uvw, cells) * amp;
        amp   *= 0.5;
        cells *= 2.0;
    }
    return clamp(w, 0.0, 1.0);
}

void main()
{
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(voxel, ivec3(pc.dim)))) return;

    vec3 uvw = (vec3(voxel) + 0.5) / float(pc.dim);

    float low  = WorleyFBM(uvw, 4.0);     // 4 → 8 → 16 cells — large-scale cloud blobs
    float high = WorleyInv(uvw, 16.0);    // 16 cells — fine detail
    float mid  = WorleyFBM(uvw, 8.0);     // 8 → 16 → 32 cells — medium swirls

    // Combined default channel — blend low + mid, subtract a small high-freq edge enhancement to
    // sharpen cloud boundaries without breaking tileability.
    float combined = clamp(mix(low, mid, 0.5) - (high - 0.5) * 0.2, 0.0, 1.0);

    imageStore(u_NoiseOut, voxel, vec4(low, high, mid, combined));
}
