#version 460
#extension GL_GOOGLE_include_directive : enable

#include "common/globals.glsl"
#include "common/restir_common.glsl"
#include "common/restir_di_target.glsl"   // #154 brdf (D_GGX/G_Smith) + GI_PI for the specular shade

// ReSTIR DI — final shading. Reads each pixel's resolved reservoir and writes the selected point
// light's contribution to the direct-lighting image.
//
// CONTRACT: this image stores DEMODULATED diffuse irradiance  E = Li * NdotL * W  (no albedo, no
// 1/PI). pbr.frag remodulates:  Lo += E * (albedo * (1-metallic) / PI)  (metals carry no Lambertian
// diffuse). SVGF denoises E before remodulation. Keep this contract in lockstep with pbr.frag's read.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, set = 1, binding = 0) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _hdrPad[3];
    PointLightData       points[];
} lights;

layout(set = 2, binding = 0) uniform sampler2D u_SceneDepth;
layout(set = 2, binding = 1) uniform sampler2D u_SlimNormal;
// Reads the final reservoir at b6 (spatial-reuse output), not b2 — the temporal buffer stays
// untouched as next frame's history; the spatial pass writes the per-frame final result here.
layout(std430, set = 2, binding = 6) readonly buffer ReservoirBuffer { Reservoir reservoirs[]; };
layout(set = 2, binding = 3, rgba16f) uniform writeonly image2D outDirectLighting;
layout(set = 2, binding = 7) uniform sampler2D u_SlimRoughness;                 // #154
layout(set = 2, binding = 8, rgba16f) uniform writeonly image2D outDirectSpec;  // #154 demodulated specular

layout(push_constant) uniform PC {
    mat4 invViewProj;
    uint candidateCount;
    uint frameSeed;
    int  gbufferScale;     // 1 = full-res; 2 = half-res DI (G-buffer reads remap to full)
    int  dispatchW;        // DI working (dispatch) resolution
    int  dispatchH;
} pc;

ivec2 GbufCoord(ivec2 p) {
    if (pc.gbufferScale == 1) return p;
    vec2  uv   = (vec2(p) + 0.5) / vec2(pc.dispatchW, pc.dispatchH);
    ivec2 full = ivec2(ubo.viewportSize);
    return clamp(ivec2(uv * vec2(full)), ivec2(0), full - 1);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(pc.dispatchW, pc.dispatchH);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    uint flatIdx = uint(pixel.y) * uint(size.x) + uint(pixel.x);

    vec3 E = vec3(0.0);
    vec3 S = vec3(0.0);   // #154 demodulated specular (F0-free lobe)

    float depth = texelFetch(u_SceneDepth, GbufCoord(pixel), 0).r;
    Reservoir r = reservoirs[flatIdx];
    if (depth < 1.0 && r.lightIndex != RESTIR_NO_LIGHT && r.W > 0.0) {
        vec2 uv       = (vec2(pixel) + 0.5) / vec2(size);
        vec4 worldH   = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
        vec3 worldPos = worldH.xyz / worldH.w;
        vec3 N        = OctDecode(texelFetch(u_SlimNormal, GbufCoord(pixel), 0).rg);

        PointLightData pl = lights.points[r.lightIndex];
        vec3 L; float dist;
        vec3 Li  = PointLightRadiance(pl, worldPos, L, dist);
        E = Li * max(dot(N, L), 0.0) * r.W;

        // #154 demodulated specular: S = Li·D·G/(4·NoV)·W (F0-free — pbr.frag applies the per-pixel F0).
        // The spec BRDF's NoL (D·F·G/(4·NoL·NoV)·NoL) cancels, leaving /(4·NoV). D/G via restir_common's brdf.
        vec3  V     = normalize(ubo.cameraPos - worldPos);
        float rough = texelFetch(u_SlimRoughness, GbufCoord(pixel), 0).r;
        vec3  H     = normalize(V + L);
        float NoV   = max(dot(N, V), 1.0e-4);
        S = Li * (D_GGX(N, H, rough) * G_Smith(N, V, L, rough) / (4.0 * NoV)) * r.W;
    }

    imageStore(outDirectLighting, pixel, vec4(E, 1.0));
    imageStore(outDirectSpec, pixel, vec4(S, 1.0));
}
