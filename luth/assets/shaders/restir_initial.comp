#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference     : require
#extension GL_EXT_buffer_reference2    : require
#extension GL_EXT_nonuniform_qualifier : require

#include "common/globals.glsl"
#include "common/restir_common.glsl"
#include "common/restir_di_target.glsl"   // #154 RestirTargetPdf (brdf + GI_PI — DI-only, not the shared header)
#include "common/geom_table.glsl"   // Set 3 Material + Set 4 bindless + AlphaTestCandidateHit/RtConfirmAlphaCandidates

// ReSTIR DI — initial candidate generation (Bitterli 2020). Per pixel: RIS over M uniformly-sampled
// point lights using an unshadowed diffuse target, then ONE rayQuery shadow ray to the selected
// light (visibility-in-target — keeps the stored reservoir bias-correct for later reuse). Writes a
// per-pixel reservoir; restir_shade.comp consumes it. Dispatched on AsyncCompute by RtRestirSubsystem.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Set 0: Global UBO (binding 0 via globals.glsl) + TLAS (binding 6). Both already COMPUTE-visible.
layout(set = 0, binding = 6) uniform accelerationStructureEXT topLevelAS;

// Set 1: LightSSBO — LightingSubsystem's Set-3 layout, remapped to set=1 in this pipeline.
layout(std430, set = 1, binding = 0) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _hdrPad[3];
    PointLightData       points[];
} lights;

// Set 2: ReSTIR pass-local.
layout(set = 2, binding = 0) uniform sampler2D u_SceneDepth;
layout(set = 2, binding = 1) uniform sampler2D u_SlimNormal;   // RG16F oct
layout(std430, set = 2, binding = 2) buffer ReservoirBuffer { Reservoir reservoirs[]; };
layout(set = 2, binding = 7) uniform sampler2D u_SlimRoughness;   // #154 combined diffuse+spec target

layout(push_constant) uniform PC {
    mat4      invViewProj;     // inverse(viewProjection), CPU-side once per view
    uint      candidateCount;  // M
    uint      frameSeed;       // per-frame decorrelation
    GeomTable geomTable;       // cutout alpha-test material fetch (paired with the bound TLAS)
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(ubo.viewportSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    uint flatIdx = uint(pixel.y) * uint(size.x) + uint(pixel.x);

    Reservoir r; ReservoirReset(r);

    float depth      = texelFetch(u_SceneDepth, pixel, 0).r;
    uint  lightCount = lights.pointLightCount;
    if (depth >= 1.0 || lightCount == 0u) {
        reservoirs[flatIdx] = r;  // sky / no lights → empty reservoir
        return;
    }

    vec2 uv       = (vec2(pixel) + 0.5) / vec2(size);
    vec4 worldH   = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPos = worldH.xyz / worldH.w;
    vec3 N        = OctDecode(texelFetch(u_SlimNormal, pixel, 0).rg);
    vec3 V        = normalize(ubo.cameraPos - worldPos);             // #154 combined target
    float rough   = texelFetch(u_SlimRoughness, pixel, 0).r;

    uint  seed       = PcgHash(flatIdx ^ pc.frameSeed);
    uint  M          = max(pc.candidateCount, 1u);
    float sourceScale = float(lightCount);  // uniform source pdf = 1/lightCount → w = pHat * lightCount

    for (uint i = 0u; i < M; ++i) {
        uint idx = min(uint(RandFromSeed(seed) * float(lightCount)), lightCount - 1u);
        PointLightData pl = lights.points[idx];
        vec3 L; float dist;
        vec3 Li = PointLightRadiance(pl, worldPos, L, dist);
        float pHat = RestirTargetPdf(N, V, L, Li, rough);  // unshadowed diffuse+spec target (#154, albedo-free)
        ReservoirUpdate(r, idx, pHat, pHat * sourceScale, RandFromSeed(seed));
    }
    ReservoirFinalize(r);

    // Visibility of the selected sample — fold into the reservoir (occluded → no contribution).
    if (r.lightIndex != RESTIR_NO_LIGHT && r.W > 0.0) {
        PointLightData pl = lights.points[r.lightIndex];
        vec3  toLight = pl.position - worldPos;
        float dist    = length(toLight);
        vec3  L       = toLight / max(dist, 1e-4);
        float tMin    = ubo.rtShadowParams.y;
        vec3  origin  = worldPos + N * (ubo.rtShadowParams.z * 0.5) + L * tMin;

        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, topLevelAS,
            gl_RayFlagsTerminateOnFirstHitEXT, GT_VIS_SOLID,
            origin, tMin, L, max(dist - 2.0 * tMin, tMin));
        RtConfirmAlphaCandidates(rq, pc.geomTable);
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT)
            r.W = 0.0;
    }

    reservoirs[flatIdx] = r;
}
