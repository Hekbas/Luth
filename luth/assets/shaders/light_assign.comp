#version 450

// Forward+ light-to-cluster assignment.
// One invocation per cluster. Point + spot lights both sphere-vs-AABB test against the cluster's
// view-space AABB; atomicAdd reserves a contiguous slot range in LightIndex; cluster grid gets
// (offset, count). Spot indices carry SPOT_INDEX_FLAG so the shading loop picks the right loader.
// LightSSBO at binding 0 reads the same VkBuffer that Set 3 exposes — tagged-heap backings carry
// both UNIFORM and STORAGE usage flags so the shaders can pick freely.

const uint TILES_X  = 16u;
const uint TILES_Y  =  9u;
const uint SLICES_Z = 48u;
const uint NUM_CLUSTERS = TILES_X * TILES_Y * SLICES_Z;
const uint MAX_LIGHTS_PER_CLUSTER = 128u;
const uint SPOT_INDEX_FLAG = 0x80000000u;   // high bit tags a cluster index as a spot (else point)

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct DirectionalLightData {
    vec3  direction;  float intensity;
    vec3  color;      float _pad;
};
struct PointLightData {
    vec3  position;   float range;
    vec3  color;      float intensity;
};
struct ClusterAABB {
    vec4 minView;
    vec4 maxView;
};

// std430 LightSSBO: header (dir light + count + pad) at offset 0, flexible points[] at offset 48.
// pbr.frag mirrors the same declaration on Set 3 binding 0.
layout(std430, set = 0, binding = 0) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 spotLightCount;
    uint                 _pad[2];
    PointLightData       points[];
} lights;

layout(std430, set = 0, binding = 1) readonly buffer ClusterAABBBuffer {
    ClusterAABB clusters[];
};

layout(std430, set = 0, binding = 2) buffer ClusterGridBuffer {
    uvec2 grid[];
};

layout(std430, set = 0, binding = 3) writeonly buffer LightIndexBuffer {
    uint indices[];
};

layout(std430, set = 0, binding = 4) buffer LightIndexCounter {
    uint counter;
};

layout(push_constant) uniform PC {
    mat4 view;
    uint pointLightCount;
    uint spotLightCount;
    uint maxLightsPerCluster;
    uint _pad;
} pc;

void main() {
    uint clusterID = gl_GlobalInvocationID.x;
    if (clusterID >= NUM_CLUSTERS) return;

    vec3 cMin = clusters[clusterID].minView.xyz;
    vec3 cMax = clusters[clusterID].maxView.xyz;

    uint local[MAX_LIGHTS_PER_CLUSTER];
    uint localCount = 0u;

    uint n = pc.pointLightCount;
    for (uint i = 0u; i < n; ++i) {
        vec3 posVS = (pc.view * vec4(lights.points[i].position, 1.0)).xyz;
        float r = lights.points[i].range;
        vec3 closest = clamp(posVS, cMin, cMax);
        vec3 d = posVS - closest;
        if (dot(d, d) <= r * r && localCount < pc.maxLightsPerCluster) {
            local[localCount] = i;
            localCount += 1u;
        }
    }

    // Spot lights share the cluster grid + index list. SpotLightData is 64 B = 2 PointLightData
    // slots, and its first 16 B (position + range) coincide with PointLightData's, so the typed
    // points[] view reads spot pos/range directly — GLSL forbids a second flexible array here.
    // MVP cull = the same sphere(range) test as points; tighter cone-vs-AABB culling is a follow-up.
    uint ns = pc.spotLightCount;
    for (uint j = 0u; j < ns; ++j) {
        uint slot = pc.pointLightCount + 2u * j;
        vec3 posVS = (pc.view * vec4(lights.points[slot].position, 1.0)).xyz;
        float r = lights.points[slot].range;
        vec3 closest = clamp(posVS, cMin, cMax);
        vec3 d = posVS - closest;
        if (dot(d, d) <= r * r && localCount < pc.maxLightsPerCluster) {
            local[localCount] = SPOT_INDEX_FLAG | j;
            localCount += 1u;
        }
    }

    uint base = 0u;
    if (localCount > 0u) base = atomicAdd(counter, localCount);
    grid[clusterID] = uvec2(base, localCount);
    for (uint k = 0u; k < localCount; ++k) {
        indices[base + k] = local[k];
    }
}
