#version 450
#extension GL_GOOGLE_include_directive : enable

// Wronski volumetric fog — light injection with Karis 3x3x3 temporal accumulation.
// Per voxel: reconstruct world position via exponential Z slicing, evaluate dir-light contribution
// with CSM shadow attenuation, iterate cluster's point lights, and modulate by local FogVolume rows.
// Then reproject to previous frame's atlas, clamp history to the 3x3x3 neighborhood of the fresh
// in-scatter value (stored in groupshared memory), and blend ~5% fresh / 95% history.
// Writes density (single atlas) + in-scatter (ping-pong with volInScatterHistory).
//
// Workgroup is 10x10x6 = 600 threads; the inner 8x8x4 = 256 threads write to the atlas. The 1-voxel
// halo computes fresh in-scatter purely to seed shared memory for the neighborhood clamp; halo
// threads outside the atlas extent contribute 0 (fog density vanishes outside the frustum anyway).

#include "common/globals.glsl"

layout(local_size_x = 10, local_size_y = 10, local_size_z = 6) in;

// ── Set 1 — volumetric subsystem state ──
layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D volDensity;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D volInScatter;

struct DirectionalLightData { vec3 direction; float intensity; vec3 color; float _pad; };
struct PointLightData       { vec3 position;  float range;     vec3 color; float intensity; };

layout(std430, set = 1, binding = 2) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _padLights[3];
    PointLightData       points[];
} lights;

layout(std430, set = 1, binding = 3) readonly buffer ClusterBuffer {
    uvec2 clusters[];
} clusterGrid;

layout(std430, set = 1, binding = 4) readonly buffer LightIndexBuffer {
    uint indices[];
} lightIndex;

struct FogVolumeRow {
    mat4 worldToVolume;
    vec3 extentsOrRadius;
    uint type;          // 0 = Box, 1 = Sphere
    vec3 color;
    float density;
    float falloffStart;
    float falloffEnd;
    uint  affectsAmbient;
    uint  _pad;
};

layout(std430, set = 1, binding = 5) readonly buffer FogVolumeBuffer {
    uint count;
    uint _padFog[3];
    FogVolumeRow volumes[];
} fog;

layout(set = 1, binding = 6) uniform sampler2DArrayShadow shadowMap;
layout(set = 1, binding = 7) uniform sampler3D volInScatterHistory;

// invView pushed each dispatch — avoids per-voxel inverse(ubo.view) (~40 ops).
layout(push_constant) uniform PC {
    mat4 invView;
} pc;

const ivec3 VOL_DIM = ivec3(160, 90, 128);
const ivec3 INNER   = ivec3(8, 8, 4);   // atlas voxels written per workgroup
const uint  k_ClusterTilesX  = 16u;
const uint  k_ClusterTilesY  =  9u;
const uint  k_ClusterSlicesZ = 24u;
const float PI = 3.14159265359;
const float kIsotropicPhase = 1.0 / (4.0 * PI);
const float kTemporalAlpha  = 0.05;     // fresh blend weight (0.05 = 95% history)

// Shared-memory tile holds this workgroup's fresh in-scatter for the 3x3x3 clamp.
// 10x10x6 vec4 = 9.6 KB — well within Vulkan's typical 32 KB workgroup limit.
shared vec4 sharedScatter[6][10][10];

// Wronski exponential Z slicing — more resolution near the camera. Inverse-symmetric to the
// composite pass's view-Z-to-slice mapping; both must stay in sync (engine ShaderCompiler has no
// #include support, so the math is replicated per shader — matches cluster_viz.frag precedent).
float SliceToViewZ(int i, float nearZ, float farZ) {
    return nearZ * pow(farZ / nearZ, (float(i) + 0.5) / float(VOL_DIM.z));
}

uint ComputeClusterIDForVoxel(ivec2 voxelXY, float viewZ) {
    float sliceF = log(max(viewZ, ubo.nearZ) / ubo.nearZ)
                 / log(ubo.farZ / ubo.nearZ) * float(k_ClusterSlicesZ);
    uint slice = uint(clamp(floor(sliceF), 0.0, float(k_ClusterSlicesZ - 1u)));
    vec2 tileScale = vec2(VOL_DIM.xy) / vec2(float(k_ClusterTilesX), float(k_ClusterTilesY));
    uvec2 tile = uvec2(floor(vec2(voxelXY) / tileScale));
    tile.x = min(tile.x, k_ClusterTilesX - 1u);
    tile.y = min(tile.y, k_ClusterTilesY - 1u);
    return slice * k_ClusterTilesX * k_ClusterTilesY + tile.y * k_ClusterTilesX + tile.x;
}

uint SelectCascade(float viewDistance) {
    for (uint i = 0u; i < 4u; ++i) {
        if (viewDistance < ubo.cascadeSplitsViewZ[i]) return i;
    }
    return 3u;
}

float SampleCSM(vec3 worldPos, uint cascade) {
    if (ubo.shadowBias[cascade] < 0.0) return 1.0;
    vec4 sc = ubo.lightSpaceMatrix[cascade] * vec4(worldPos, 1.0);
    vec3 ndc = sc.xyz / sc.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 ||
        ndc.z <  0.0 || ndc.z > 1.0)
        return 1.0;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depthRef = ndc.z - ubo.shadowBias[cascade];
    return texture(shadowMap, vec4(uv, float(cascade), depthRef));
}

// Compute fresh per-voxel density + in-scatter at the given atlas coord. Also fills outWorldPos
// for the caller's reprojection. Out-of-atlas coords return (0,0).
void ComputeFreshInScatter(ivec3 voxelRaw, out vec3 outInScatter, out float outDensity, out vec3 outWorldPos)
{
    outInScatter = vec3(0.0);
    outDensity   = 0.0;
    outWorldPos  = vec3(0.0);
    if (any(lessThan(voxelRaw, ivec3(0))) || any(greaterThanEqual(voxelRaw, VOL_DIM)))
        return;

    // Voxel center → NDC.xy + view-space Z (positive distance from camera).
    vec2 uv = (vec2(voxelRaw.xy) + 0.5) / vec2(VOL_DIM.xy);
    vec2 ndcXY = uv * 2.0 - 1.0;
    float viewZ = SliceToViewZ(voxelRaw.z, ubo.nearZ, ubo.farZ);
    float vsZ   = -viewZ; // view-space Z is negative (RH, -Z forward)

    float vsX = ndcXY.x * (-vsZ) / ubo.projection[0][0];
    float vsY = ndcXY.y * (-vsZ) / ubo.projection[1][1];
    vec3 viewPos  = vec3(vsX, vsY, vsZ);
    outWorldPos   = (pc.invView * vec4(viewPos, 1.0)).xyz;

    float density = 0.0;
    vec3  emit    = vec3(0.0);
    for (uint i = 0u; i < fog.count; ++i) {
        FogVolumeRow v = fog.volumes[i];
        vec3 localPos = (v.worldToVolume * vec4(outWorldPos, 1.0)).xyz;
        float d = 0.0;
        bool inside = false;
        if (v.type == 0u) {
            vec3 e = max(v.extentsOrRadius, vec3(1e-4));
            vec3 r = abs(localPos) / e;
            d = max(max(r.x, r.y), r.z);
            inside = d <= 1.0;
        } else {
            float r = max(v.extentsOrRadius.x, 1e-4);
            d = length(localPos) / r;
            inside = d <= 1.0;
        }
        if (!inside) continue;
        float fEnd   = max(v.falloffEnd,   1e-4);
        float fStart = clamp(v.falloffStart, 0.0, fEnd);
        float fall   = clamp((fEnd - d) / max(fEnd - fStart, 1e-4), 0.0, 1.0);
        density += v.density * fall;
        emit    += v.color * v.density * fall * (v.affectsAmbient != 0u ? 1.0 : 0.0);
    }
    density = max(density, 0.0);

    vec3 dirContrib = vec3(0.0);
    if (density > 1e-4 && lights.dirLight.intensity > 0.0) {
        uint cascade = SelectCascade(viewZ);
        float shadow = SampleCSM(outWorldPos, cascade);
        dirContrib = lights.dirLight.color * lights.dirLight.intensity * shadow * kIsotropicPhase;
    }

    vec3 pointContrib = vec3(0.0);
    if (density > 1e-4) {
        uint cid = ComputeClusterIDForVoxel(voxelRaw.xy, viewZ);
        uvec2 lc = clusterGrid.clusters[cid];
        uint lightOffset = lc.x;
        uint lightCount  = lc.y;
        for (uint j = 0u; j < lightCount; ++j) {
            uint li = lightIndex.indices[lightOffset + j];
            PointLightData p = lights.points[li];
            vec3 toLight = p.position - outWorldPos;
            float dist2 = dot(toLight, toLight);
            float r2 = p.range * p.range;
            if (dist2 > r2) continue;
            float dist  = sqrt(dist2);
            float atten = max(1.0 - dist / p.range, 0.0);
            atten *= atten;
            pointContrib += p.color * p.intensity * atten * kIsotropicPhase;
        }
    }

    vec3 inScatter = (dirContrib + pointContrib + emit) * density;

    // Hillaire 2nd-order multi-scatter — analytic boost proportional to local extinction.
    // Factor saturates near 1+msK as density grows; integrate's Beer-Lambert keeps total
    // transmittance energy-bounded so this can't blow up.
    float msK = ubo.heightFogParams.w;
    if (msK > 0.0) {
        inScatter *= 1.0 + msK * (1.0 - exp(-density));
    }

    outInScatter = inScatter;
    outDensity   = density;
}

void main() {
    // localID==1 maps to workgroup's first inner voxel; localID==0 is the -1 halo entry.
    ivec3 voxelRaw = ivec3(gl_WorkGroupID) * INNER
                   + ivec3(gl_LocalInvocationID) - ivec3(1, 1, 1);

    vec3  freshScatter;
    float density;
    vec3  worldPos;
    ComputeFreshInScatter(voxelRaw, freshScatter, density, worldPos);

    // Halo + inner threads alike seed the 3x3x3 clamp tile.
    sharedScatter[gl_LocalInvocationID.z][gl_LocalInvocationID.y][gl_LocalInvocationID.x]
        = vec4(freshScatter, 0.0);

    barrier();

    // Only the inner 8x8x4 = 256 threads write to the atlas. Halo threads exit here — their
    // contribution lives entirely in shared memory. Y dispatch overshoots the atlas (12*8=96 vs
    // VOL_DIM.y=90), so inner threads can still map to OOB voxels; skip those before write.
    bool isInner = (gl_LocalInvocationID.x - 1u) < uint(INNER.x)
                && (gl_LocalInvocationID.y - 1u) < uint(INNER.y)
                && (gl_LocalInvocationID.z - 1u) < uint(INNER.z)
                && all(greaterThanEqual(voxelRaw, ivec3(0)))
                && all(lessThan(voxelRaw, VOL_DIM));
    if (!isInner) return;

    // Reproject voxel center to previous frame's clip space. prev nearZ/farZ assumed equal to
    // current frame's — the engine fixes them per-view and does not change them per-frame; if a
    // future camera feature breaks that, history reprojection skews during the change.
    vec4 prevClip = ubo.prevViewProjection * vec4(worldPos, 1.0);
    vec3 prevNDC  = prevClip.xyz / prevClip.w;
    bool historyValid = all(greaterThanEqual(prevNDC.xy, vec2(-1.0)))
                     && all(lessThanEqual(prevNDC.xy, vec2(1.0)))
                     && prevNDC.z >= 0.0 && prevNDC.z <= 1.0
                     && prevClip.w > 0.0;

    vec3 finalScatter = freshScatter;
    if (historyValid) {
        vec2  prevUV  = prevNDC.xy * 0.5 + 0.5;
        float prevVZ  = (ubo.nearZ * ubo.farZ) / (prevNDC.z * (ubo.nearZ - ubo.farZ) + ubo.farZ);
        float sliceW  = clamp(log(max(prevVZ, ubo.nearZ) / ubo.nearZ)
                            / log(ubo.farZ / ubo.nearZ), 0.0, 1.0);
        vec3 historySample = texture(volInScatterHistory, vec3(prevUV, sliceW)).rgb;

        // Karis 3x3x3 min/max clamp from fresh values in shared memory.
        vec3 lo = vec3(1e9);
        vec3 hi = vec3(-1e9);
        for (int dz = -1; dz <= 1; ++dz)
        for (int dy = -1; dy <= 1; ++dy)
        for (int dx = -1; dx <= 1; ++dx) {
            vec3 n = sharedScatter[int(gl_LocalInvocationID.z) + dz]
                                  [int(gl_LocalInvocationID.y) + dy]
                                  [int(gl_LocalInvocationID.x) + dx].rgb;
            lo = min(lo, n);
            hi = max(hi, n);
        }
        historySample = clamp(historySample, lo, hi);

        // 5% fresh / 95% history — heavy smoothing; the clamp box prevents stale ghosting.
        finalScatter = mix(historySample, freshScatter, kTemporalAlpha);
    }

    // voxelRaw == in-bounds voxel coord for inner threads by construction.
    imageStore(volDensity,   voxelRaw, vec4(density, density, density, 0.0));
    imageStore(volInScatter, voxelRaw, vec4(finalScatter, 0.0));
}
