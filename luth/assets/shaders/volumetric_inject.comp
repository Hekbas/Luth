#version 450

// Wronski volumetric fog — light injection.
// Per voxel: reconstruct world position via exponential Z slicing, evaluate dir-light contribution
// with CSM shadow attenuation, iterate cluster's point lights, and modulate by local FogVolume rows.
// Writes density (RGB extinction proxy + alpha placeholder) + in-scatter (RGB radiance + pad) to the
// 3D atlas pair. The integrate pass walks Z and accumulates transmittance.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

// ── Set 0 — Global Uniforms (mirrors pbr.frag) ──
layout(set = 0, binding = 0) uniform GlobalUniforms {
    mat4 viewProjection;
    mat4 prevViewProjection;
    mat4 view;
    mat4 projection;
    vec3 cameraPos;
    float time;
    mat4 lightSpaceMatrix[4];
    vec4 cascadeSplitsViewZ;
    vec4 shadowBias;
    vec4 shadowNormalBias;
    vec4 cascadeTexelSize;
    float iblIntensity;
    float skyboxIntensity;
    float debugVisualizeCascades;
    float cascadeBlendWidth;
    vec2  viewportSize;
    float nearZ;
    float farZ;
} ubo;

// ── Set 1 — volumetric subsystem state ──
layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D volDensity;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D volInScatter;

struct DirectionalLightData { vec3 direction; float intensity; vec3 color; float _pad; };
struct PointLightData       { vec3 position;  float range;     vec3 color; float intensity; };

layout(std430, set = 1, binding = 2) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _padLights[3];
    PointLightData       points[];
} lights;

layout(std430, set = 1, binding = 3) readonly buffer ClusterBuffer {
    uvec2 clusters[];
} clusterGrid;

layout(std430, set = 1, binding = 4) readonly buffer LightIndexBuffer {
    uint indices[];
} lightIndex;

struct FogVolumeRow {
    mat4 worldToVolume;
    vec3 extentsOrRadius;
    uint type;          // 0 = Box, 1 = Sphere
    vec3 color;
    float density;
    float falloffStart;
    float falloffEnd;
    uint  affectsAmbient;
    uint  _pad;
};

layout(std430, set = 1, binding = 5) readonly buffer FogVolumeBuffer {
    uint count;
    uint _padFog[3];
    FogVolumeRow volumes[];
} fog;

layout(set = 1, binding = 6) uniform sampler2DArrayShadow shadowMap;

// invView pushed each dispatch — avoids per-voxel inverse(ubo.view) (~40 ops).
layout(push_constant) uniform PC {
    mat4 invView;
} pc;

const ivec3 VOL_DIM = ivec3(160, 90, 128);
const uint  k_ClusterTilesX  = 16u;
const uint  k_ClusterTilesY  =  9u;
const uint  k_ClusterSlicesZ = 24u;
const float PI = 3.14159265359;
const float kIsotropicPhase = 1.0 / (4.0 * PI);

// Wronski exponential Z slicing — more resolution near the camera. Inverse-symmetric to the
// composite pass's view-Z-to-slice mapping; both must stay in sync (engine ShaderCompiler has no
// #include support, so the math is replicated per shader — matches cluster_viz.frag precedent).
float SliceToViewZ(uint i, float nearZ, float farZ) {
    return nearZ * pow(farZ / nearZ, (float(i) + 0.5) / float(VOL_DIM.z));
}

uint ComputeClusterIDForVoxel(ivec2 voxelXY, float viewZ) {
    float sliceF = log(max(viewZ, ubo.nearZ) / ubo.nearZ)
                 / log(ubo.farZ / ubo.nearZ) * float(k_ClusterSlicesZ);
    uint slice = uint(clamp(floor(sliceF), 0.0, float(k_ClusterSlicesZ - 1u)));
    vec2 tileScale = vec2(VOL_DIM.xy) / vec2(float(k_ClusterTilesX), float(k_ClusterTilesY));
    uvec2 tile = uvec2(floor(vec2(voxelXY) / tileScale));
    tile.x = min(tile.x, k_ClusterTilesX - 1u);
    tile.y = min(tile.y, k_ClusterTilesY - 1u);
    return slice * k_ClusterTilesX * k_ClusterTilesY + tile.y * k_ClusterTilesX + tile.x;
}

uint SelectCascade(float viewDistance) {
    for (uint i = 0u; i < 4u; ++i) {
        if (viewDistance < ubo.cascadeSplitsViewZ[i]) return i;
    }
    return 3u;
}

float SampleCSM(vec3 worldPos, uint cascade) {
    if (ubo.shadowBias[cascade] < 0.0) return 1.0;
    vec4 sc = ubo.lightSpaceMatrix[cascade] * vec4(worldPos, 1.0);
    vec3 ndc = sc.xyz / sc.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 ||
        ndc.z <  0.0 || ndc.z > 1.0)
        return 1.0;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depthRef = ndc.z - ubo.shadowBias[cascade];
    return texture(shadowMap, vec4(uv, float(cascade), depthRef));
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(voxel, VOL_DIM))) return;

    // Voxel center → NDC.xy + view-space Z (positive distance from camera).
    vec2 uv = (vec2(voxel.xy) + 0.5) / vec2(VOL_DIM.xy);
    vec2 ndcXY = uv * 2.0 - 1.0;
    float viewZ = SliceToViewZ(uint(voxel.z), ubo.nearZ, ubo.farZ);
    float vsZ   = -viewZ; // view-space Z is negative (RH, -Z forward)

    // Reconstruct view-space XY from NDC + projection diagonal.
    float vsX = ndcXY.x * (-vsZ) / ubo.projection[0][0];
    float vsY = ndcXY.y * (-vsZ) / ubo.projection[1][1];
    vec3 viewPos  = vec3(vsX, vsY, vsZ);
    vec3 worldPos = (pc.invView * vec4(viewPos, 1.0)).xyz;

    // Local fog-volume modulation. Box: |localPos| / extents <= 1 inside. Sphere: |localPos| / r <= 1.
    // Falloff lerps from 1 at falloffStart to 0 at falloffEnd, both normalized to the shape distance.
    float density = 0.0;
    vec3  emit    = vec3(0.0);
    for (uint i = 0u; i < fog.count; ++i) {
        FogVolumeRow v = fog.volumes[i];
        vec3 localPos = (v.worldToVolume * vec4(worldPos, 1.0)).xyz;
        float d = 0.0;
        bool inside = false;
        if (v.type == 0u) {
            vec3 e = max(v.extentsOrRadius, vec3(1e-4));
            vec3 r = abs(localPos) / e;
            d = max(max(r.x, r.y), r.z);
            inside = d <= 1.0;
        } else {
            float r = max(v.extentsOrRadius.x, 1e-4);
            d = length(localPos) / r;
            inside = d <= 1.0;
        }
        if (!inside) continue;
        float fEnd   = max(v.falloffEnd,   1e-4);
        float fStart = clamp(v.falloffStart, 0.0, fEnd);
        float fall   = clamp((fEnd - d) / max(fEnd - fStart, 1e-4), 0.0, 1.0);
        density += v.density * fall;
        emit    += v.color * v.density * fall * (v.affectsAmbient != 0u ? 1.0 : 0.0);
    }
    density = max(density, 0.0);

    // Directional light + CSM-attenuated visibility. Skip when density is zero — voxel doesn't scatter.
    vec3 dirContrib = vec3(0.0);
    if (density > 1e-4 && lights.dirLight.intensity > 0.0) {
        uint cascade = SelectCascade(viewZ);
        float shadow = SampleCSM(worldPos, cascade);
        dirContrib = lights.dirLight.color * lights.dirLight.intensity * shadow * kIsotropicPhase;
    }

    // Cluster point-light iteration. Cluster ID from voxel's screen-space tile + Olsson slice index.
    vec3 pointContrib = vec3(0.0);
    if (density > 1e-4) {
        uint cid = ComputeClusterIDForVoxel(voxel.xy, viewZ);
        uvec2 lc = clusterGrid.clusters[cid];
        uint lightOffset = lc.x;
        uint lightCount  = lc.y;
        for (uint j = 0u; j < lightCount; ++j) {
            uint li = lightIndex.indices[lightOffset + j];
            PointLightData p = lights.points[li];
            vec3 toLight = p.position - worldPos;
            float dist2 = dot(toLight, toLight);
            float r2 = p.range * p.range;
            if (dist2 > r2) continue;
            float dist  = sqrt(dist2);
            float atten = max(1.0 - dist / p.range, 0.0);
            atten *= atten;
            pointContrib += p.color * p.intensity * atten * kIsotropicPhase;
        }
    }

    vec3 inScatter = (dirContrib + pointContrib + emit) * density;

    imageStore(volDensity,   voxel, vec4(density, density, density, 0.0));
    imageStore(volInScatter, voxel, vec4(inScatter, 0.0));
}
