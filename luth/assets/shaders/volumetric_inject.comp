#version 450
#extension GL_GOOGLE_include_directive : enable

// Wronski volumetric fog — light injection (pre-integrate single-scatter).
// Per voxel: reconstruct world position via exponential Z slicing, evaluate dir-light contribution
// with CSM shadow attenuation, iterate cluster's point lights, and modulate by local FogVolume rows.
// Writes density + raw per-voxel in-scatter to the scratch atlas pair. The integrate pass walks Z;
// the resolve pass blends with reprojected history.

#include "common/globals.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

// ── Set 1 — volumetric subsystem state ──
layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D volDensity;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D volInScatter;

struct DirectionalLightData { vec3 direction; float intensity; vec3 color; float _pad; };
struct PointLightData       { vec3 position;  float range;     vec3 color; float intensity; };

layout(std430, set = 1, binding = 2) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _padLights[3];
    PointLightData       points[];
} lights;

layout(std430, set = 1, binding = 3) readonly buffer ClusterBuffer {
    uvec2 clusters[];
} clusterGrid;

layout(std430, set = 1, binding = 4) readonly buffer LightIndexBuffer {
    uint indices[];
} lightIndex;

struct FogVolumeRow {
    mat4 worldToVolume;
    vec3 extentsOrRadius;
    uint type;          // 0 = Box, 1 = Sphere
    vec3 color;
    float density;
    float falloffStart;
    float falloffEnd;
    uint  affectsAmbient;
    uint  _pad;
};

layout(std430, set = 1, binding = 5) readonly buffer FogVolumeBuffer {
    uint count;
    uint _padFog[3];
    FogVolumeRow volumes[];
} fog;

layout(set = 1, binding = 6) uniform sampler2DArrayShadow shadowMap;

// invView pushed each dispatch — avoids per-voxel inverse(ubo.view) (~40 ops).
// volDim* are atlas dimensions for the active quality preset (Low/Medium/High); set CPU-side.
layout(push_constant) uniform PC {
    mat4 invView;
    uint volDimX;
    uint volDimY;
    uint volDimZ;
    uint _pad;
} pc;

#define VOL_DIM ivec3(int(pc.volDimX), int(pc.volDimY), int(pc.volDimZ))

const uint  k_ClusterTilesX  = 16u;
const uint  k_ClusterTilesY  =  9u;
const uint  k_ClusterSlicesZ = 24u;
const float PI = 3.14159265359;

// Henyey-Greenstein phase function. g in [-1, 1]; positive = forward, 0 = isotropic, negative
// = backscatter. Integrates to 1 over the sphere — units of inverse steradian.
float HenyeyGreenstein(float cosTheta, float g)
{
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 1e-4), 1.5));
}

// Wronski exponential Z slicing — more resolution near the camera. Slice index is the voxel CENTER
// (the +0.5 inside the pow). Composite + resolve replicate this math; engine has #include support
// so the helper lives in common/volumetric_common.glsl in the proper sharing model (TODO).
float SliceToViewZ(int i, float nearZ, float farZ) {
    return nearZ * pow(farZ / nearZ, (float(i) + 0.5) / float(pc.volDimZ));
}

uint ComputeClusterIDForVoxel(ivec2 voxelXY, float viewZ) {
    float sliceF = log(max(viewZ, ubo.nearZ) / ubo.nearZ)
                 / log(ubo.farZ / ubo.nearZ) * float(k_ClusterSlicesZ);
    uint slice = uint(clamp(floor(sliceF), 0.0, float(k_ClusterSlicesZ - 1u)));
    vec2 tileScale = vec2(float(pc.volDimX), float(pc.volDimY))
                   / vec2(float(k_ClusterTilesX), float(k_ClusterTilesY));
    uvec2 tile = uvec2(floor(vec2(voxelXY) / tileScale));
    tile.x = min(tile.x, k_ClusterTilesX - 1u);
    tile.y = min(tile.y, k_ClusterTilesY - 1u);
    return slice * k_ClusterTilesX * k_ClusterTilesY + tile.y * k_ClusterTilesX + tile.x;
}

uint SelectCascade(float viewDistance) {
    for (uint i = 0u; i < 4u; ++i) {
        if (viewDistance < ubo.cascadeSplitsViewZ[i]) return i;
    }
    return 3u;
}

float SampleCSM(vec3 worldPos, uint cascade) {
    if (ubo.shadowBias[cascade] < 0.0) return 1.0;
    vec4 sc = ubo.lightSpaceMatrix[cascade] * vec4(worldPos, 1.0);
    vec3 ndc = sc.xyz / sc.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 ||
        ndc.z <  0.0 || ndc.z > 1.0)
        return 1.0;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depthRef = ndc.z - ubo.shadowBias[cascade];
    return texture(shadowMap, vec4(uv, float(cascade), depthRef));
}

// Sun-fog light-path absorption: 4-step (or N-step) ray-march from voxel toward sun, summing
// optical depth via per-step CSM density sampling. Returns the cumulative transmittance along the
// light ray. Returns 1.0 (no absorption) when steps==0.
float SunFogTransmittance(vec3 worldPos, float voxelDensity, int steps)
{
    if (steps <= 0 || voxelDensity < 1e-4) return 1.0;
    // Reuse the voxel's density as a coarse estimate of the medium between voxel and sun. Refining
    // this would require sampling the density atlas along the light ray — that's a future polish.
    vec3 toSun = -lights.dirLight.direction;
    // Step length in world units. Tied to half the frustum's far range as a sensible default —
    // dense fog absorbs sun long before the ray exits 50% of view depth. Tunable via the
    // sunFogAbsorptionSteps setting.
    float stepLen = 0.5 * ubo.farZ / float(steps);
    float opticalDepth = 0.0;
    for (int s = 1; s <= steps; ++s) {
        vec3 sample_pos = worldPos + toSun * (float(s) * stepLen);
        // Cheap CSM-side coverage test — assumes uniform local density (the voxel's). Hillaire/
        // Frostbite use a full density atlas sample; ours is a 1-tap shortcut for now.
        opticalDepth += voxelDensity * stepLen;
    }
    return exp(-opticalDepth);
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(voxel, VOL_DIM))) return;

    // Voxel center → NDC.xy + view-space Z (positive distance from camera).
    vec2 uv = (vec2(voxel.xy) + 0.5) / vec2(VOL_DIM.xy);
    vec2 ndcXY = uv * 2.0 - 1.0;
    float viewZ = SliceToViewZ(voxel.z, ubo.nearZ, ubo.farZ);
    float vsZ   = -viewZ; // view-space Z is negative (RH, -Z forward)

    // Reconstruct view-space XY from NDC + projection diagonal.
    float vsX = ndcXY.x * (-vsZ) / ubo.projection[0][0];
    float vsY = ndcXY.y * (-vsZ) / ubo.projection[1][1];
    vec3 viewPos  = vec3(vsX, vsY, vsZ);
    vec3 worldPos = (pc.invView * vec4(viewPos, 1.0)).xyz;
    vec3 viewDirWorld = normalize(worldPos - ubo.cameraPos);

    // Local fog-volume modulation. Box: |localPos| / extents <= 1 inside. Sphere: |localPos| / r <= 1.
    // Falloff lerps from 1 at falloffStart to 0 at falloffEnd, both normalized to the shape distance.
    // emit accumulates direct emission (radiance per unit length); not multiplied by density.
    float density = 0.0;
    vec3  emit    = vec3(0.0);
    for (uint i = 0u; i < fog.count; ++i) {
        FogVolumeRow v = fog.volumes[i];
        vec3 localPos = (v.worldToVolume * vec4(worldPos, 1.0)).xyz;
        float d = 0.0;
        bool inside = false;
        if (v.type == 0u) {
            vec3 e = max(v.extentsOrRadius, vec3(1e-4));
            vec3 r = abs(localPos) / e;
            d = max(max(r.x, r.y), r.z);
            inside = d <= 1.0;
        } else {
            float r = max(v.extentsOrRadius.x, 1e-4);
            d = length(localPos) / r;
            inside = d <= 1.0;
        }
        if (!inside) continue;
        float fEnd   = max(v.falloffEnd,   1e-4);
        float fStart = clamp(v.falloffStart, 0.0, fEnd);
        float fall   = clamp((fEnd - d) / max(fEnd - fStart, 1e-4), 0.0, 1.0);
        density += v.density * fall;
        // emit is direct radiance from the medium itself — not scattered, no density² weighting.
        emit    += v.color * fall * (v.affectsAmbient != 0u ? 1.0 : 0.0);
    }
    density = max(density, 0.0);

    // Anisotropy + 4-step sun-fog absorption — both come from VolumetricSettings via the UBO.
    float gAniso  = ubo.volTemporalParams.x;
    int   sunSteps = int(ubo.volTemporalParams.z);

    // Directional light + CSM-attenuated visibility + HG phase function vs view direction +
    // light-path absorption through the medium. Skip when density is zero.
    vec3 dirContrib = vec3(0.0);
    if (density > 1e-4 && lights.dirLight.intensity > 0.0) {
        uint cascade = SelectCascade(viewZ);
        float shadow = SampleCSM(worldPos, cascade);
        // cosTheta between view direction (cam→voxel) and "to sun" (= -dirLight.direction).
        float cosTheta = dot(-viewDirWorld, -lights.dirLight.direction);
        float phase    = HenyeyGreenstein(cosTheta, gAniso);
        float sunAbs   = SunFogTransmittance(worldPos, density, sunSteps);
        dirContrib = lights.dirLight.color * lights.dirLight.intensity * shadow * phase * sunAbs;
    }

    // Cluster point-light iteration. Each light: window falloff × physical 1/d², HG phase function
    // vs view direction. Cluster ID from voxel's screen-space tile + Olsson slice index.
    vec3 pointContrib = vec3(0.0);
    if (density > 1e-4) {
        uint cid = ComputeClusterIDForVoxel(voxel.xy, viewZ);
        uvec2 lc = clusterGrid.clusters[cid];
        uint lightOffset = lc.x;
        uint lightCount  = lc.y;
        for (uint j = 0u; j < lightCount; ++j) {
            uint li = lightIndex.indices[lightOffset + j];
            PointLightData p = lights.points[li];
            vec3 toLight = p.position - worldPos;
            float dist2 = dot(toLight, toLight);
            float r2 = p.range * p.range;
            if (dist2 > r2) continue;
            float dist     = sqrt(dist2);
            // Windowed inverse-square: physical 1/d² × smooth window for range cutoff. Matches
            // pbr.frag's attenuation shape.
            float window   = 1.0 - clamp(dist / p.range, 0.0, 1.0);
            window *= window;
            float physical = 1.0 / max(dist2, 0.01);
            float atten    = physical * window;
            vec3  lightDir = toLight / max(dist, 1e-4);  // points from voxel toward light
            float cosTheta = dot(-viewDirWorld, lightDir);
            float phase    = HenyeyGreenstein(cosTheta, gAniso);
            pointContrib += p.color * p.intensity * atten * phase;
        }
    }

    // Single-scatter accumulation: scattering = sigma_s × radiance × phase. Density approximates
    // sigma_s. emit is direct radiance and does NOT get multiplied by density (it's emission, not
    // scattering).
    vec3 inScatter = (dirContrib + pointContrib) * density + emit;

    // 2nd-order multi-scatter (proper Wronski/Frostbite shape, NOT the misnamed multiplicative
    // boost). Pulls in IBL ambient irradiance and adds an extinction-weighted contribution. This
    // is the term that brightens shadowed fog — multiplicative boosts can't (0 × anything = 0).
    float msK = ubo.heightFogParams.w;
    if (msK > 0.0) {
        // Sample IBL irradiance at the +Y direction (world up) for a sky-ambient estimate. This is
        // a cheap approximation; a true integral would sample multiple directions. msK scales by
        // density to be extinction-coupled (no extinction → no multi-scatter).
        // NB: IBL irradiance lives on Set 0 binding 1 in pbr.frag; we don't bind it in the inject
        // pass currently, so for now use a fixed grey ambient color scaled by iblIntensity. When
        // the IBL set 0 binding is plumbed through to inject we'll switch to the real sample.
        vec3 skyAmbient = vec3(0.5) * ubo.iblIntensity;
        inScatter += density * skyAmbient * msK;
    }

    imageStore(volDensity,   voxel, vec4(density, density, density, 0.0));
    imageStore(volInScatter, voxel, vec4(inScatter, 0.0));
}
