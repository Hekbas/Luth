#version 460
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_ray_query            : require

// Volumetric fog inject — scatter pass. Reads volDensity (density.r + tint.gba) for the current
// voxel + samples the density atlas along the sun ray for proper density-aware absorption (god
// rays carve through varying fog correctly — the prior single-pass inject's uniform-density
// shortcut over-attenuated and killed the rays). Computes CSM-shadowed dir-light, clustered point
// lights, and IBL multi-scatter, all phase-weighted by HG, then writes vec4(inScatter, 0.0) to
// volInScatter scratch. The integrate pass walks Z and replaces .a with transmittance.
//
// Splitting density off into a separate prior pass is what unlocks reading density at voxels we
// didn't write in this dispatch — the RG barrier between density and scatter passes guarantees all
// density writes are visible before any scatter read fires.
//
// CONTRACT (Wronski 2014 / Hillaire 2015):
//   inject writes  scat = albedo × J,  with  J = Σ_lights phase × L × visibility  +  ambient.
//   integrate accumulates  transmit × scat × (1 − exp(−σ_t · dt))  per slice.
//   Together they reconstruct  σ_s × J × (1 − exp(−σ_t · dt)) / σ_t  for albedo = σ_s/σ_t.
// Do NOT pre-multiply by density here — that's the σ_t factor that integrate's (1 − exp) supplies.
// Adding it back would double-apply σ_t and dim the fog by σ_t (≈ 10× at density 0.1).

#include "common/globals.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

// Set 0 binding 1 = IBL irradiance cubemap (multi-scatter ambient term, Wronski/Frostbite shape).
layout(set = 0, binding = 1) uniform samplerCube irradianceMap;
// Set 0 binding 6 = scene TLAS (RT fog shadows — point lights + arbitrary occluders, gated by rtFog).
layout(set = 0, binding = 6) uniform accelerationStructureEXT topLevelAS;

// Set 1 — scatter pass state.
layout(set = 1, binding = 0)          uniform sampler3D       volDensity;     // .r density, .gba tint
layout(set = 1, binding = 1, rgba16f) uniform writeonly image3D volInScatter;

struct DirectionalLightData { vec3 direction; float intensity; vec3 color; float _pad; };
struct PointLightData       { vec3 position;  float range;     vec3 color; float intensity; };

layout(std430, set = 1, binding = 2) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _padLights[3];
    PointLightData       points[];
} lights;

layout(std430, set = 1, binding = 3) readonly buffer ClusterBuffer {
    uvec2 clusters[];
} clusterGrid;

layout(std430, set = 1, binding = 4) readonly buffer LightIndexBuffer {
    uint indices[];
} lightIndex;

layout(set = 1, binding = 5) uniform sampler2DArrayShadow shadowMap;

layout(push_constant) uniform PC {
    mat4 invView;
    uint volDimX;
    uint volDimY;
    uint volDimZ;
    uint _pad;
} pc;

#define VOL_DIM ivec3(int(pc.volDimX), int(pc.volDimY), int(pc.volDimZ))

const uint  k_ClusterTilesX  = 16u;
const uint  k_ClusterTilesY  =  9u;
const uint  k_ClusterSlicesZ = 48u;
const float PI = 3.14159265359;

float HenyeyGreenstein(float cosTheta, float g)
{
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 1e-4), 1.5));
}

float SliceToViewZ(int i, float nearZ, float farZ) {
    return nearZ * pow(farZ / nearZ, (float(i) + 0.5) / float(pc.volDimZ));
}

uint ComputeClusterIDForVoxel(ivec2 voxelXY, float viewZ) {
    float sliceF = log(max(viewZ, ubo.nearZ) / ubo.nearZ)
                 / log(ubo.farZ / ubo.nearZ) * float(k_ClusterSlicesZ);
    uint slice = uint(clamp(floor(sliceF), 0.0, float(k_ClusterSlicesZ - 1u)));
    vec2 tileScale = vec2(float(pc.volDimX), float(pc.volDimY))
                   / vec2(float(k_ClusterTilesX), float(k_ClusterTilesY));
    uvec2 tile = uvec2(floor(vec2(voxelXY) / tileScale));
    tile.x = min(tile.x, k_ClusterTilesX - 1u);
    tile.y = min(tile.y, k_ClusterTilesY - 1u);
    return slice * k_ClusterTilesX * k_ClusterTilesY + tile.y * k_ClusterTilesX + tile.x;
}

uint SelectCascade(float viewDistance) {
    for (uint i = 0u; i < 4u; ++i) {
        if (viewDistance < ubo.cascadeSplitsViewZ[i]) return i;
    }
    return 3u;
}

float SampleCSM(vec3 worldPos, uint cascade) {
    if (ubo.shadowBias[cascade] < 0.0) return 1.0;
    vec4 sc = ubo.lightSpaceMatrix[cascade] * vec4(worldPos, 1.0);
    vec3 ndc = sc.xyz / sc.w;
    if (ndc.x < -1.0 || ndc.x > 1.0 || ndc.y < -1.0 || ndc.y > 1.0 ||
        ndc.z <  0.0 || ndc.z > 1.0)
        return 1.0;
    vec2 uv = ndc.xy * 0.5 + 0.5;
    float depthRef = ndc.z - ubo.shadowBias[cascade];
    return texture(shadowMap, vec4(uv, float(cascade), depthRef));
}

// World→atlas UVW for sun-ray density sampling. Inverts inject_density's voxel→world chain:
// view = ubo.view * world; UV from perspective divide; W via Wronski log-Z. Returns .w = 1.0 on a
// valid sample, .w = 0.0 when the position falls outside the camera frustum atlas (behind camera,
// past farZ, or off the lateral frustum) — caller skips those.
vec4 WorldToAtlasUVW(vec3 worldPos)
{
    vec3 vp = (ubo.view * vec4(worldPos, 1.0)).xyz;
    float vz = -vp.z;
    if (vz < ubo.nearZ || vz > ubo.farZ) return vec4(0.0);
    vec2 uv = vec2(vp.x * ubo.projection[0][0] / -vp.z,
                   vp.y * ubo.projection[1][1] / -vp.z) * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec4(0.0);
    float slice = log(vz / ubo.nearZ) / log(ubo.farZ / ubo.nearZ);
    return vec4(uv, slice, 1.0);
}

// Sun-fog absorption: N-step ray march toward the sun, sampling the density atlas per step for
// density-aware extinction. Out-of-frustum samples contribute zero (known limitation — the
// world-space sun LUT from Hillaire/Frostbite is future polish). stepLen = 2 m gives a
// 2·steps-meter local path.
float SunFogTransmittance(vec3 worldPos, int steps)
{
    if (steps <= 0) return 1.0;
    vec3 toSun = -lights.dirLight.direction;
    const float stepLen = 2.0;
    float opticalDepth = 0.0;
    for (int s = 1; s <= steps; ++s) {
        vec3 sp = worldPos + toSun * (float(s) * stepLen);
        vec4 uvw = WorldToAtlasUVW(sp);
        if (uvw.w < 0.5) continue;
        opticalDepth += texture(volDensity, uvw.xyz).r * stepLen;
    }
    return exp(-opticalDepth);
}

// RT shadow ray (opaque-only): true iff `dir` is unoccluded from the froxel center up to maxDist. The
// froxel is free space (no surface) → no Wächter-Binder normal offset, the dir·sMin nudge suffices.
// Mirrors the surface RT consumers' Visible() (rt_reflections.comp). The returned visibility multiplies
// J's per-light L term — it does NOT touch the σ_t/density path, so the CONTRACT above is unchanged.
bool Visible(vec3 x, vec3 dir, float maxDist) {
    float sMin  = ubo.rtShadowParams.y;
    vec3  sOrig = x + dir * sMin;
    rayQueryEXT sq;
    rayQueryInitializeEXT(sq, topLevelAS,
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
        sOrig, sMin, dir, max(maxDist, sMin));
    rayQueryProceedEXT(sq);
    return rayQueryGetIntersectionTypeEXT(sq, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

void main() {
    ivec3 voxel = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(voxel, VOL_DIM))) return;

    // Voxel center → world (same construction as inject_density so the two passes agree).
    vec2 uv    = (vec2(voxel.xy) + 0.5) / vec2(VOL_DIM.xy);
    vec2 ndcXY = uv * 2.0 - 1.0;
    float viewZ = SliceToViewZ(voxel.z, ubo.nearZ, ubo.farZ);
    float vsZ   = -viewZ;
    float vsX   = ndcXY.x * (-vsZ) / ubo.projection[0][0];
    float vsY   = ndcXY.y * (-vsZ) / ubo.projection[1][1];
    vec3  worldPos     = (pc.invView * vec4(vec3(vsX, vsY, vsZ), 1.0)).xyz;
    vec3  viewDirWorld = normalize(worldPos - ubo.cameraPos);

    // Density + tint from the just-written volDensity. texelFetch (no interp) at the voxel center
    // — interpolation across cells would mix tints at boundaries and bias against the discrete
    // grid; sun-ray sampling below uses texture() because there interpolation is desirable.
    vec4 d4 = texelFetch(volDensity, voxel, 0);
    float density = d4.r;
    vec3  tint    = d4.gba;
    if (density < 1e-4) {
        imageStore(volInScatter, voxel, vec4(0.0));
        return;
    }

    float gAniso   = ubo.volTemporalParams.x;
    int   sunSteps = int(ubo.volTemporalParams.z);
    bool  rtFog    = ubo.volScatterParams.z > 0.5;   // RT fog shadows (point lights + sun) toggle

    // Dir light: CSM shadow × HG forward-scatter × density-aware sun absorption.
    // cosTheta uses dirLight.direction (incident, sun→scene) vs -viewDirWorld (outgoing, voxel→cam)
    // so HG forward peak (cosθ = +1) hits when the camera looks toward the sun through the voxel.
    vec3 dirContrib = vec3(0.0);
    if (lights.dirLight.intensity > 0.0) {
        // RT mode: one shadow ray toward the sun (arbitrary occluders); else the CSM cascade. The sunAbs
        // density-march below stays in BOTH modes — it's in-medium extinction, distinct from occlusion.
        float shadow   = rtFog
            ? (Visible(worldPos, -lights.dirLight.direction, 1.0e30) ? 1.0 : 0.0)
            : SampleCSM(worldPos, SelectCascade(viewZ));
        float cosTheta = dot(lights.dirLight.direction, -viewDirWorld);
        float phase    = HenyeyGreenstein(cosTheta, gAniso);
        float sunAbs   = SunFogTransmittance(worldPos, sunSteps);
        dirContrib = lights.dirLight.color * lights.dirLight.intensity * shadow * phase * sunAbs;
    }

    // Clustered point lights — windowed 1/d² × HG phase. Cluster ID from voxel screen-tile + Olsson
    // slice, matching pbr.frag's binning so the inject sees the same per-cluster light lists.
    vec3 pointContrib = vec3(0.0);
    {
        uint cid = ComputeClusterIDForVoxel(voxel.xy, viewZ);
        uvec2 lc = clusterGrid.clusters[cid];
        uint lightOffset = lc.x;
        uint lightCount  = lc.y;
        for (uint j = 0u; j < lightCount; ++j) {
            uint li = lightIndex.indices[lightOffset + j];
            PointLightData p = lights.points[li];
            vec3 toLight = p.position - worldPos;
            float dist2 = dot(toLight, toLight);
            float r2 = p.range * p.range;
            if (dist2 > r2) continue;
            float dist     = sqrt(dist2);
            float window   = 1.0 - clamp(dist / p.range, 0.0, 1.0);
            window *= window;
            float physical = 1.0 / max(dist2, 0.01);
            float atten    = physical * window;
            vec3  incident = -toLight / max(dist, 1e-4);
            float cosTheta = dot(incident, -viewDirWorld);
            float phase    = HenyeyGreenstein(cosTheta, gAniso);
            // RT shadow ray toward the light (-incident = froxel→light). Off → unshadowed (today's path).
            if (rtFog && !Visible(worldPos, -incident, dist - 2.0 * ubo.rtShadowParams.y)) continue;
            pointContrib += p.color * p.intensity * atten * phase;
        }
    }

    // scat = albedo × J (per CONTRACT above). No × density here — integrate supplies the σ_t path
    // factor via (1 − exp(−σ_t · dt)). Pre-multiplying would double-apply σ_t and dim by σ_t.
    vec3 inScatter = tint * (dirContrib + pointContrib);

    // 2nd-order multi-scatter: IBL ambient × albedo. Survives in shadow where single-scatter is
    // zero, so dense fog in shadow still picks up sky bounce. msK is user-tunable.
    float msK = ubo.heightFogParams.w;
    if (msK > 0.0) {
        vec3 skyAmbient = texture(irradianceMap, vec3(0.0, 1.0, 0.0)).rgb * ubo.iblIntensity;
        inScatter += skyAmbient * msK * tint;
    }

    // Artistic post-canonical multiplier on the entire in-scatter (single + multi). HG phase + dir
    // light gives ~75× brightness ratio between sun-axis and off-axis voxels — physically correct but
    // visually leaves ambient fog dim. UE5 / Frostbite expose this same knob; > 1 is energy non-
    // conservative by design. The CONTRACT above describes the formula BEFORE this multiplier; the
    // multiplier is an artistic scaling on top, not part of the physical model.
    inScatter *= ubo.volScatterParams.x;

    imageStore(volInScatter, voxel, vec4(inScatter, 0.0));
}
