#version 450

// Blue-noise-like dither texture bake. Uses Martin Roberts' R2 plastic-number quasi-random
// sequence — a low-discrepancy 2D stippling pattern with blue-noise-LIKE spectrum. One-line
// math, no iteration needed; deterministic per-pixel.
//
// Source: Martin Roberts, "The Unreasonable Effectiveness of Quasirandom Sequences"
// (extremelearning.com.au, 2018). Used in production by various indie engines and matches the
// "good enough" bar for fog slice dither once TAA integrates it across ~6 frames.
//
// One-shot bake at VolumetricSubsystem::Init. Sampler is NEAREST + REPEAT — bilinear filtering
// would destroy the spectral high-frequency properties that make dither integrate cleanly.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0, r8) uniform writeonly image2D u_BlueNoiseOut;

layout(push_constant) uniform PC {
    uint dim;  // 64 (texture side)
} pc;

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(pc.dim)))) return;

    // R2 sequence: g = plastic number (positive real root of x³ = x + 1). Per-pixel value =
    // fractional part of dot(coord, (1/g, 1/g²)). The dot's irrational coefficients ensure no
    // 2D periodicity within the tile; the fract() wraps cleanly so REPEAT sampling is seamless.
    const float g = 1.32471795724474602596;
    const vec2  a = vec2(1.0 / g, 1.0 / (g * g));
    float value   = fract(0.5 + dot(vec2(p), a));

    imageStore(u_BlueNoiseOut, ivec2(p), vec4(value, 0.0, 0.0, 0.0));
}
