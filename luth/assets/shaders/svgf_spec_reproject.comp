#version 460
#extension GL_GOOGLE_include_directive : enable

#include "common/globals.glsl"
#include "common/svgf_common.glsl"

// SVGF temporal accumulation — SPECULAR variant (rt-renderer D.1). Identical to svgf_reproject.comp
// except the reprojection is HIT-DISTANCE-DRIVEN: a reflection's screen motion differs from the
// surface's, so reprojecting by the slim motion vector ghosts mirror reflections. Instead reconstruct
// the receiver world pos from depth, mirror-reflect the view to the virtual reflected hit
// (worldPos + reflect(-V,N)·hitDist), and reproject THAT through prevViewProjection. The 1-spp specular
// radiance + its hitDist arrive packed in u_SpecIn (rgb = radiance, a = hitDist); hitDist is carried in
// the geom history's spare channel so disocclusion also rejects on reflected-depth discontinuity, and
// roughness loosens that tolerance (a blurry reflection is hitDist-insensitive).
// invariant: prev/curr history selected by frame parity in C++ (set[p] reads [p^1], writes [p]).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// set 0 = global UBO (invViewProjection, prevViewProjection, cameraPos, viewportSize, nearZ, farZ).
layout(set = 1, binding = 0)  uniform sampler2D u_SpecIn;     // current 1-spp radiance (rgb) + hitDist (a)
layout(set = 1, binding = 1)  uniform sampler2D u_CurrDepth;
layout(set = 1, binding = 2)  uniform sampler2D u_CurrNormal; // slim oct normal
layout(set = 1, binding = 3)  uniform sampler2D u_CurrRough;  // slim roughness (R8) — disocclusion tuning
layout(set = 1, binding = 4, rgba16f) uniform readonly image2D u_ColorHistPrev;
layout(set = 1, binding = 5, rgba16f) uniform readonly image2D u_MomentsPrev;
layout(set = 1, binding = 6, rgba16f) uniform readonly image2D u_GeomPrev;   // prev (linearZ, octN.x, octN.y, hitDist)
layout(set = 1, binding = 7,  rgba16f) uniform writeonly image2D outColor;
layout(set = 1, binding = 8,  rgba16f) uniform writeonly image2D outMoments;
layout(set = 1, binding = 9,  rgba16f) uniform writeonly image2D outGeom;

layout(push_constant) uniform PC {
    float alphaColor;
    float alphaMoments;
    float historyCap;
    float depthThreshold;
    float normalThreshold;
    int   gbufferScale;     // unused — Reflections is full-res; present so the shared PC range matches
    int   dispatchW;
    int   dispatchH;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(ubo.viewportSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2  octN    = texelFetch(u_CurrNormal, pixel, 0).rg;
    vec3  N       = SvgfOctDecode(octN);
    float depth   = texelFetch(u_CurrDepth, pixel, 0).r;
    float curLinZ = SvgfLinearizeDepth(depth);
    vec4  spec    = texelFetch(u_SpecIn, pixel, 0);
    float hitDist = max(spec.a, 0.0);
    float rough   = texelFetch(u_CurrRough, pixel, 0).r;

    // Carry geometry + reflected hit-distance forward for next frame's disocclusion (all pixels).
    imageStore(outGeom, pixel, vec4(curLinZ, octN.x, octN.y, hitDist));

    // Sky / background — no reflection to accumulate; reset history so a later disocclusion starts clean.
    if (depth >= 1.0) {
        imageStore(outColor,   pixel, vec4(0.0));
        imageStore(outMoments, pixel, vec4(0.0));
        return;
    }

    vec3  di     = clamp(spec.rgb, 0.0, 65504.0);
    float curLum = min(SvgfLuminance(di), 255.0);

    // Hit-distance virtual reprojection: reconstruct the receiver, mirror-reflect the view, push out to
    // the virtual reflected hit, reproject through last frame's view-projection.
    vec2 uv       = (vec2(pixel) + 0.5) / vec2(size);
    vec4 worldH   = ubo.invViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPos = worldH.xyz / worldH.w;
    vec3 V        = normalize(ubo.cameraPos - worldPos);
    vec3 virtualP = worldPos + reflect(-V, N) * hitDist;
    vec4 prevClip = ubo.prevViewProjection * vec4(virtualP, 1.0);
    vec2 prevUV   = (prevClip.w > 0.0) ? (prevClip.xy / prevClip.w * 0.5 + 0.5) : vec2(-1.0);

    vec2  prevPixF = prevUV * vec2(size) - 0.5;
    ivec2 p0       = ivec2(floor(prevPixF));
    vec2  fr       = prevPixF - vec2(p0);
    float bw[4]    = float[4]((1.0 - fr.x) * (1.0 - fr.y), fr.x * (1.0 - fr.y),
                              (1.0 - fr.x) * fr.y,         fr.x * fr.y);
    ivec2 off[4]   = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

    vec3  pColor = vec3(0.0);
    vec2  pMom   = vec2(0.0);
    float pHist  = 0.0;
    float sumw   = 0.0;
    // Rougher reflections are blurry → hitDist-insensitive, so loosen the reflected-depth gate.
    float hitTol = pc.depthThreshold * (1.0 + rough * 4.0);
    bool inBounds = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));
    if (inBounds) {
        for (int i = 0; i < 4; ++i) {
            ivec2 tp = p0 + off[i];
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, size))) continue;

            vec4  g        = imageLoad(u_GeomPrev, tp);
            float prevLinZ = g.r;
            vec3  prevN    = SvgfOctDecode(g.gb);
            float prevHit  = g.a;
            bool  ok = abs(curLinZ - prevLinZ) < pc.depthThreshold * curLinZ
                    && dot(prevN, N) > pc.normalThreshold
                    && abs(hitDist - prevHit) < hitTol * max(hitDist, prevHit) + 0.01;
            if (!ok) continue;

            float w = bw[i];
            pColor += w * imageLoad(u_ColorHistPrev, tp).rgb;
            vec3  m = imageLoad(u_MomentsPrev, tp).rgb;   // mu1, mu2, histLen
            pMom   += w * m.rg;
            pHist  += w * m.b;
            sumw   += w;
        }
    }

    float histLen;
    vec3  color;
    vec2  mom;
    if (sumw > 0.01) {
        float inv = 1.0 / sumw;
        pColor *= inv;  pMom *= inv;  pHist *= inv;
        histLen   = min(pc.historyCap, pHist + 1.0);
        float a   = max(pc.alphaColor,   1.0 / histLen);
        float am  = max(pc.alphaMoments, 1.0 / histLen);
        color = mix(pColor, di, a);
        mom   = mix(pMom, vec2(curLum, curLum * curLum), am);
    } else {
        // Disocclusion — discard history, full replace.
        histLen = 1.0;
        color   = di;
        mom     = vec2(curLum, curLum * curLum);
    }

    float variance = mom.y - mom.x * mom.x;
    variance = (isinf(variance) || isnan(variance)) ? 0.0 : max(0.0, variance);
    imageStore(outColor,   pixel, vec4(color, variance));
    imageStore(outMoments, pixel, vec4(mom, histLen, 0.0));
}
