#version 460
#extension GL_EXT_buffer_reference     : require
#extension GL_EXT_buffer_reference2    : require
#extension GL_EXT_scalar_block_layout  : require

// Per-vertex compute deformation for STATIC meshes opted into the deformation seam (D3). Reads the
// source Vertex VB directly (scalar buffer_reference), applies a GLOBAL procedural wind in object
// space, and writes the post-deform vertex in the interleaved Vertex layout to the per-mesh deformed
// buffer that the BLAS refit + geometry table + raster VS all consume — RT-correct by construction
// (the same buffer raster reads). Deformation is object-space + per-asset, so instances of one mesh
// deform in lockstep (intended D3 scope); the per-vertex spatial phase gives intra-mesh motion.
// Per-entity wind authoring + a richer model (gusts/masks) are D4.
//
// CONTRACT: input layout MUST match Model.h::Vertex (scalar/tight, 52 B): vec3 pos@0, vec3 normal@12,
// vec2 uv0@24, vec2 uv1@32, vec3 tangent@40 — locked by static_assert in VulkanAccelerationStructure.cpp.
//
// CONTRACT: the deformed output MUST match the Vertex layout material.slang::GatherHitGeometry reads
// — 13 floats/vert: pos@0-2, normal@3-5, uv0@6-7, uv1@8-9, tangent@10-12. Byte-identical to
// skinning.comp's output so a deformable mesh routes through the same deformed pipelines + BLAS path.
// Normal/tangent PASS THROUGH (bind pose) for D3 — the bend is low-frequency, so the shading error is
// second-order; recompute-from-bend-gradient is a future refinement.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Vertex
{
    vec3 position;   // @0
    vec3 normal;     // @12
    vec2 uv0;        // @24
    vec2 uv1;        // @32
    vec3 tangent;    // @40
};

layout(buffer_reference, scalar, buffer_reference_align = 4) readonly buffer InputBuf
{
    Vertex verts[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) writeonly buffer DeformedBuf
{
    float verts[];       // interleaved Vertex: 13 floats/vert (pos, normal, uv0, uv1, tangent)
};

// std430, scalars only (no vec member) so the C++ DeformPC matches without vec4-alignment surprises.
layout(push_constant, std430) uniform PC
{
    InputBuf    inputBuf;
    DeformedBuf deformedBuf;
    uint        vertexCount;
    float       time;
    float       windX;
    float       windY;
    float       windZ;
    float       strength;
    float       mainBendScale;
    float       detailScale;
    float       frequency;
} pc;

// Smoothed triangle wave (Crysis, GPU Gems 3) — cheaper than sin, visually similar. Output in [0,1].
vec4 smoothTriangleWave(vec4 x)
{
    vec4 tri = abs(fract(x + 0.5) * 2.0 - 1.0);
    return tri * tri * (3.0 - 2.0 * tri);
}

void main()
{
    const uint vid = gl_GlobalInvocationID.x;
    if (vid >= pc.vertexCount) return;

    const Vertex v = pc.inputBuf.verts[vid];
    const vec3 windDir = vec3(pc.windX, pc.windY, pc.windZ);   // CPU passes it normalized

    vec3 p = v.position;

    // Spatial per-vertex phase → intra-mesh variation (leaves/folds move out of step). Object-space,
    // so it is identical across instances (the per-asset lockstep is the intended D3 scope).
    const float vtxPhase = dot(p, vec3(0.91, 0.0, 0.43));
    const vec4  phases   = vec4(pc.time * pc.frequency + vtxPhase) + vec4(0.0, 1.97, 0.79, 0.37);
    const vec4  wave     = smoothTriangleWave(phases) * 2.0 - 1.0;   // [-1, 1]

    // Main bend — sway along the wind direction, weighted by height above the local base
    // (assumes +Y up, base at local y=0: the standing-banner / tree / grass case).
    const float height   = max(p.y, 0.0);
    const float mainWave = (wave.x + wave.y) * 0.5;
    p += windDir * (pc.strength * pc.mainBendScale * height * mainWave);

    // Detail bend — small per-vertex shimmer along the normal (cloth folds / leaf flutter).
    const float detailWave = (wave.z + wave.w) * 0.5;
    p += v.normal * (pc.strength * pc.detailScale * detailWave);

    const uint base = vid * 13u;            // 13 floats per interleaved Vertex
    pc.deformedBuf.verts[base +  0u] = p.x;
    pc.deformedBuf.verts[base +  1u] = p.y;
    pc.deformedBuf.verts[base +  2u] = p.z;
    pc.deformedBuf.verts[base +  3u] = v.normal.x;   // pass-through (bind pose) — see CONTRACT
    pc.deformedBuf.verts[base +  4u] = v.normal.y;
    pc.deformedBuf.verts[base +  5u] = v.normal.z;
    pc.deformedBuf.verts[base +  6u] = v.uv0.x;
    pc.deformedBuf.verts[base +  7u] = v.uv0.y;
    pc.deformedBuf.verts[base +  8u] = v.uv1.x;
    pc.deformedBuf.verts[base +  9u] = v.uv1.y;
    pc.deformedBuf.verts[base + 10u] = v.tangent.x;
    pc.deformedBuf.verts[base + 11u] = v.tangent.y;
    pc.deformedBuf.verts[base + 12u] = v.tangent.z;
}
