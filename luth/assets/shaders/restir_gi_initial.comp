#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_buffer_reference   : require
#extension GL_EXT_buffer_reference2  : require
#extension GL_EXT_nonuniform_qualifier : require

#include "common/globals.glsl"
#include "common/restir_gi_common.glsl"
#include "common/geom_table.glsl"   // shared GeomTable + FetchHitSurface (Set 3 Material SSBO + Set 4 bindless)

// ReSTIR GI — initial 1-bounce path-sample generation (Ouyang 2021). Per pixel: reconstruct the
// primary hit x_v, cosine-sample one hemisphere direction, trace it to the secondary hit x_s, shade
// x_s's outgoing radiance L_o toward x_v (single-light NEE), and store a GI reservoir (M=1). The
// reconnection Jacobian is applied later (temporal/spatial reuse), never here. AsyncCompute.
//
// S3: the secondary surface's real material drives L_o. instanceCustomIndex indexes a per-frame
// geometry table (BDA in pc) → {vertexBDA, indexBDA, materialSlot, stride}; the hit triangle's verts
// are deref'd via GL_EXT_buffer_reference2 for barycentric UVs + a world-space geometric normal, then
// the bindless Material SSBO gives albedo/emission. Skinned hits read bind-pose attributes (the hit
// POINT rides the deformed TLAS; only n_s/UV are bind-pose — acceptable for a 1-bounce diffuse term).
// Set GI_USE_SCAFFOLD_LO 1 to fall back to S0's constant albedo + receiver-facing normal (debug).

#define GI_USE_SCAFFOLD_LO 0

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Set 0: Global UBO (b0 via globals.glsl) + TLAS (b6). Both COMPUTE-visible.
layout(set = 0, binding = 6) uniform accelerationStructureEXT topLevelAS;

// Set 1: LightSSBO — LightingSubsystem's Set-3 layout, remapped to set=1 in this pipeline.
layout(std430, set = 1, binding = 0) readonly buffer LightBuffer {
    DirectionalLightData dirLight;
    uint                 pointLightCount;
    uint                 _hdrPad[3];
    PointLightData       points[];
} lights;

// Set 2: GI pass-local. b2 = curr GI reservoir (write).
layout(set = 2, binding = 0) uniform sampler2D u_SceneDepth;
layout(set = 2, binding = 1) uniform sampler2D u_SlimNormal;   // RG16F oct
layout(std430, set = 2, binding = 2) buffer ReservoirBuffer { GIReservoir reservoirs[]; };

// Set 3 (Material SSBO) + Set 4 (bindless textures) + the GeomTable buffer_reference layout + the
// hit-surface deref all live in common/geom_table.glsl (shared with path_trace.comp).

layout(push_constant) uniform PC {
    mat4      invViewProj;
    uint      frameSeed;
    float     secondaryAlbedo;   // S0/scaffold constant only
    float     maxIndirect;       // firefly clamp on L_o luminance
    uint      _pad1;
    GeomTable geomTable;         // 64-bit handle; 0 before the first real TLAS build
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(ubo.viewportSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    uint flatIdx = uint(pixel.y) * uint(size.x) + uint(pixel.x);

    GIReservoir r; GIReservoirReset(r);

    float depth      = texelFetch(u_SceneDepth, pixel, 0).r;
    uint  lightCount = lights.pointLightCount;
    if (depth >= 1.0) { reservoirs[flatIdx] = r; return; }   // sky → empty sample

    vec2 octNv    = texelFetch(u_SlimNormal, pixel, 0).rg;
    vec3 Nv       = OctDecode(octNv);
    vec2 uv       = (vec2(pixel) + 0.5) / vec2(size);
    vec4 worldH   = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPos = worldH.xyz / worldH.w;

    uint seed = PcgHash(flatIdx ^ (pc.frameSeed * 2654435761u));

    // Cosine-sample one bounce direction; pdf = cos/pi (solid angle). Sequence the two stream draws
    // into locals — GLSL leaves argument evaluation order unspecified, so an inline vec2(rand, rand)
    // would pick u.x/u.y driver-dependently.
    float u0 = RandFromSeed(seed);
    float u1 = RandFromSeed(seed);
    float pdf;
    vec3  d = SampleCosHemisphere(Nv, vec2(u0, u1), pdf);

    // Trace the bounce to the closest opaque hit (no terminate flag → committed = nearest).
    float tMin   = ubo.rtShadowParams.y;
    vec3  origin = worldPos + Nv * ubo.rtShadowParams.z + d * tMin;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS, gl_RayFlagsOpaqueEXT, 0xFFu, origin, tMin, d, 1.0e30);
    while (rayQueryProceedEXT(rq)) {}
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        reservoirs[flatIdx] = r;   // miss (sky / open) → empty GI sample
        return;
    }
    float t  = rayQueryGetIntersectionTEXT(rq, true);
    vec3  xs = origin + d * t;

    // Secondary surface: normal n_s, diffuse albedo, emission.
    vec3 ns;
    vec3 baseColor;
    vec3 emission = vec3(0.0);
#if GI_USE_SCAFFOLD_LO
    ns        = normalize(worldPos - xs);    // faces back toward the receiver
    baseColor = vec3(pc.secondaryAlbedo);
#else
    uint   ci  = uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true));
    uint   pi  = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    vec2   bc  = rayQueryGetIntersectionBarycentricsEXT(rq, true);
    mat4x3 o2w = rayQueryGetIntersectionObjectToWorldEXT(rq, true);
    HitSurface hs = FetchHitSurface(pc.geomTable, ci, pi, bc, o2w, d);
    ns        = hs.ng;   // GI keeps the geometric secondary normal (unchanged from before the shared helper)
    baseColor = hs.baseColor;
    emission  = hs.emission;
#endif

    // L_o at x_s toward x_v = emission + single-light NEE (Lambertian secondary). One light picked
    // uniformly; * lightCount divides out the 1/lightCount source pdf.
    vec3 Lo = emission;
    if (lightCount > 0u) {
        uint j = min(uint(RandFromSeed(seed) * float(lightCount)), lightCount - 1u);
        PointLightData pl = lights.points[j];
        vec3 Lw; float ld;
        vec3 Li  = PointLightRadiance(pl, xs, Lw, ld);
        float ndl = max(dot(ns, Lw), 0.0);
        if (ndl > 0.0) {
            float sMin  = ubo.rtShadowParams.y;
            vec3  sOrig = xs + ns * (ubo.rtShadowParams.z * 0.5) + Lw * sMin;
            rayQueryEXT sq;
            rayQueryInitializeEXT(sq, topLevelAS,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
                sOrig, sMin, Lw, max(ld - 2.0 * sMin, sMin));
            rayQueryProceedEXT(sq);
            float vis = (rayQueryGetIntersectionTypeEXT(sq, true) != gl_RayQueryCommittedIntersectionNoneEXT) ? 0.0 : 1.0;
            Lo += (baseColor / GI_PI) * Li * ndl * vis * float(lightCount);
        }
    }

    // Sun (directional) NEE — evaluated deterministically (not folded into the random point pick): a
    // single dominant light is lower-noise sampled every path. Diffuse only, same form as the point
    // term + pbr.frag's dirRadiance convention (color·intensity, no 1/d²). One shadow ray to infinity.
    if (lights.dirLight.intensity > 0.0) {
        vec3  Lsun   = normalize(-lights.dirLight.direction);   // toward the sun
        float ndlSun = max(dot(ns, Lsun), 0.0);
        if (ndlSun > 0.0) {
            float sMin  = ubo.rtShadowParams.y;
            vec3  sOrig = xs + ns * (ubo.rtShadowParams.z * 0.5) + Lsun * sMin;
            rayQueryEXT sq;
            rayQueryInitializeEXT(sq, topLevelAS,
                gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
                sOrig, sMin, Lsun, 1.0e30);
            rayQueryProceedEXT(sq);
            float vis = (rayQueryGetIntersectionTypeEXT(sq, true) != gl_RayQueryCommittedIntersectionNoneEXT) ? 0.0 : 1.0;
            Lo += (baseColor / GI_PI) * lights.dirLight.color * lights.dirLight.intensity * ndlSun * vis;
        }
    }

    // Firefly clamp on the secondary radiance before it enters spatiotemporal reuse.
    float lum = Luminance(Lo);
    if (lum > pc.maxIndirect) Lo *= pc.maxIndirect / lum;

    // Single-candidate reservoir. GIReservoirUpdate seeds the sample on the first candidate even at
    // w=0 (an unlit/shadowed hit is a confident zero with a VALID x_s — the reset origin would feed
    // the downstream reconnection Jacobian garbage; see restir_gi_common.glsl). W resolves to 1/pdf
    // when lit (target cancels in finalize), 0 when unlit. targetPdf recomputed, not stored.
    float pHat = GiTargetFunction(xs, Lo, worldPos, Nv);
    float w    = (pdf > 0.0) ? pHat / pdf : 0.0;
    GIReservoirUpdate(r, xs, Lo, OctEncode(ns), w, 0.5);
    GIReservoirFinalize(r, pHat);
    r.age             = 0u;
    r.visPos          = worldPos;              // self-carried receiver pos (temporal Jacobian)
    r.visNormalPacked = packHalf2x16(octNv);  // self-carried receiver normal as uint (validation)

    reservoirs[flatIdx] = r;
}
