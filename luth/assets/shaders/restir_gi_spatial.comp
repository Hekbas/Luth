#version 460
#extension GL_GOOGLE_include_directive : enable

#include "common/globals.glsl"
#include "common/restir_gi_common.glsl"

// ReSTIR GI — spatial reuse (Ouyang 2021) with RTXDI BASIC bias correction. Merges each pixel's
// temporal-output reservoir (b2, read-only) with a few disk neighbours into a SEPARATE spatial output
// (b6); neighbours must be read un-modified, never in-place. Each reused neighbour is reweighted by
// the reconnection Jacobian (Eq. 11) — neighbour receiver (orig) → this pixel (new), shared sample
// point. The final unbiased weight uses the BASIC MIS-like normalization (pi/piSum, no extra rays)
// instead of biased 1/M: re-evaluate the SELECTED sample's target at every contributing domain. Runs
// between temporal and shade; shade reads b6.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform sampler2D u_SceneDepth;
layout(set = 2, binding = 1) uniform sampler2D u_SlimNormal;
layout(std430, set = 2, binding = 2) readonly buffer ReservoirIn  { GIReservoir inRes[]; };   // temporal out
layout(std430, set = 2, binding = 6)          buffer ReservoirOut { GIReservoir outRes[]; };  // spatial out

layout(push_constant) uniform PC {
    mat4  invViewProj;
    uint  neighboursRadius;   // neighbours (low 16) | radius px (high 16)
    uint  frameSeed;
    float depthThreshold;     // relative linear-depth tolerance
    float normalThreshold;    // min dot(neighbourN, currN)
} pc;

const uint GI_MAX_DOMAINS = 9u;   // canonical + up to 8 neighbours (BASIC denominator records)

float LinearizeDepth(float d) {
    return (ubo.nearZ * ubo.farZ) / (ubo.farZ - d * (ubo.farZ - ubo.nearZ));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(ubo.viewportSize);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    uint flatIdx = uint(pixel.y) * uint(size.x) + uint(pixel.x);

    float depth = texelFetch(u_SceneDepth, pixel, 0).r;
    GIReservoir canonical = inRes[flatIdx];
    if (depth >= 1.0) { outRes[flatIdx] = canonical; return; }   // sky → passthrough

    vec2  octN     = texelFetch(u_SlimNormal, pixel, 0).rg;
    vec3  N        = OctDecode(octN);
    vec2  uv       = (vec2(pixel) + 0.5) / vec2(size);
    vec4  worldH   = pc.invViewProj * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3  worldPos = worldH.xyz / worldH.w;
    float linDepth = LinearizeDepth(depth);

    const uint  neighbours = min(pc.neighboursRadius & 0xFFFFu, GI_MAX_DOMAINS - 1u);
    const float radius     = float(pc.neighboursRadius >> 16);

    uint seed = PcgHash(flatIdx ^ (pc.frameSeed * 2654435761u));

    // Per-domain surface records for the BASIC denominator (index 0 = canonical / this pixel).
    vec3 domPos[GI_MAX_DOMAINS];
    vec3 domN[GI_MAX_DOMAINS];
    uint domM[GI_MAX_DOMAINS];
    uint domCount = 0u;

    GIReservoir c; GIReservoirReset(c);
    int selDomain = -1;

    // Canonical (this pixel) — identity shift, no Jacobian. ALWAYS seeds the reservoir's sample
    // (domain 0): valid geometry even when its W=0, so the neighbour reconnection Jacobian + the shade
    // read get a real x_s, not the reset origin (which biased reuse to the worldPos.z<0 half-space).
    {
        float pHat = GiTargetFunction(canonical.samplePos, canonical.sampleRadiance, worldPos, N);
        domPos[domCount] = worldPos; domN[domCount] = N; domM[domCount] = canonical.M;
        float w = pHat * canonical.W * float(canonical.M);
        c.wSum += w; c.M += canonical.M;
        RandFromSeed(seed);  // keep the neighbour RNG stream aligned with the prior conditional draw
        c.samplePos = canonical.samplePos; c.sampleRadiance = canonical.sampleRadiance;
        c.sampleNormalOct = canonical.sampleNormalOct; c.age = canonical.age;
        selDomain = int(domCount);
        domCount += 1u;
    }

    for (uint i = 0u; i < neighbours; ++i) {
        float ang = RandFromSeed(seed) * 6.28318530718;
        float rad = sqrt(RandFromSeed(seed)) * radius;
        ivec2 q = pixel + ivec2(round(cos(ang) * rad), round(sin(ang) * rad));
        if (q.x < 0 || q.y < 0 || q.x >= size.x || q.y >= size.y || (q.x == pixel.x && q.y == pixel.y)) continue;

        float qDepth = texelFetch(u_SceneDepth, q, 0).r;
        if (qDepth >= 1.0) continue;
        vec3  qN = OctDecode(texelFetch(u_SlimNormal, q, 0).rg);
        if (dot(qN, N) < pc.normalThreshold) continue;                       // normal reject
        float qLin = LinearizeDepth(qDepth);
        if (abs(qLin - linDepth) > pc.depthThreshold * linDepth) continue;   // depth reject

        uint qFlat = uint(q.y) * uint(size.x) + uint(q.x);
        GIReservoir nr = inRes[qFlat];
        if (nr.M == 0u) continue;   // gate on confidence only (RTXDI): a zero-W neighbour still owes its M to piSum

        // Neighbour receiver world pos (current frame).
        vec2 qUv = (vec2(q) + 0.5) / vec2(size);
        vec4 qWh = pc.invViewProj * vec4(qUv * 2.0 - 1.0, qDepth, 1.0);
        vec3 qWorldPos = qWh.xyz / qWh.w;

        // Reconnection Jacobian: orig = neighbour receiver, new = this pixel; shared nr.samplePos.
        vec3  nrSampleN = OctDecode(nr.sampleNormalOct);
        float jac = GiReconnectionJacobian(worldPos, qWorldPos, nr.samplePos, nrSampleN);
        if (!GiValidateJacobian(jac)) continue;

        float pHat = GiTargetFunction(nr.samplePos, nr.sampleRadiance, worldPos, N);
        domPos[domCount] = qWorldPos; domN[domCount] = qN; domM[domCount] = nr.M;
        float w = (pHat * jac) * nr.W * float(nr.M);
        c.wSum += w; c.M += nr.M;
        if (c.wSum > 0.0 && RandFromSeed(seed) * c.wSum <= w) {
            c.samplePos = nr.samplePos; c.sampleRadiance = nr.sampleRadiance;
            c.sampleNormalOct = nr.sampleNormalOct; c.age = nr.age;
            selDomain = int(domCount);
        }
        domCount += 1u;
    }

    // RTXDI BASIC bias correction. W = wSum * pi / (selTgt * piSum), where piSum sums the SELECTED
    // sample's target pdf re-evaluated at every contributing domain (× that domain's M), and pi is the
    // selected sample's target at the domain it was drawn from. Removes the 1/M domain-mismatch bias
    // with no extra rays. With no accepted neighbours this collapses to W = canonical.W (passthrough).
    float selTgt = GiTargetFunction(c.samplePos, c.sampleRadiance, worldPos, N);
    float piSum = 0.0;
    float selPi = 0.0;
    for (uint d = 0u; d < domCount; ++d) {
        float ps = GiTargetFunction(c.samplePos, c.sampleRadiance, domPos[d], domN[d]);
        piSum += ps * float(domM[d]);
        if (int(d) == selDomain) selPi = ps;
    }
    c.W = (selTgt > 0.0 && piSum > 0.0 && c.M > 0u) ? (c.wSum * selPi / (selTgt * piSum)) : 0.0;

    // Carry receiver geometry (shade ignores it; kept for struct consistency / future feedback).
    c.visPos          = worldPos;
    c.visNormalPacked = packHalf2x16(octN);
    outRes[flatIdx] = c;
}
