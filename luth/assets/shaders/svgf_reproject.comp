#version 460
#extension GL_GOOGLE_include_directive : enable

#include "common/globals.glsl"
#include "common/svgf_common.glsl"

// SVGF temporal accumulation (Schied 2017). Reprojects the previous frame's integrated color +
// luminance moments through the motion vector (2x2 bilinear, each tap depth/normal validated),
// blends the current noisy DI in with an exponential moving average, and estimates per-pixel
// luminance variance from the accumulated moments. Per-pixel geometry (linear depth + oct normal)
// is carried in a history buffer for next frame's disocclusion test — fwidth/derivatives don't
// exist in compute, so the test uses a relative linear-depth tolerance + a normal dot (the proven
// ReSTIR-temporal form). Output feeds the consumer directly until the a-trous pass lands.
//
// invariant: prev/curr history buffers are selected by frame parity in C++ — svgfReprojectDescSet[p]
// binds prev = hist[p^1] (samplers b4-b6) and curr = hist[p] (storage b7-b9).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// set 0 = global UBO (viewportSize, nearZ, farZ).
layout(set = 1, binding = 0)  uniform sampler2D u_DiIn;          // current noisy demodulated DI
layout(set = 1, binding = 1)  uniform sampler2D u_CurrDepth;
layout(set = 1, binding = 2)  uniform sampler2D u_CurrNormal;    // slim oct normal
layout(set = 1, binding = 3)  uniform sampler2D u_Motion;        // slim NDC motion delta
// Prev history are persistent storage images kept in GENERAL (no per-frame layout transition); the
// ping-pong + timeline make the cross-frame read safe. Current-frame inputs above stay sampled.
layout(set = 1, binding = 4, rgba16f) uniform readonly image2D u_ColorHistPrev; // prev color + variance
layout(set = 1, binding = 5, rgba16f) uniform readonly image2D u_MomentsPrev;   // prev (mu1, mu2, histLen)
layout(set = 1, binding = 6, rgba16f) uniform readonly image2D u_GeomPrev;      // prev (linearZ, octN.x, octN.y)

// outColor (colorHist[curr]) holds the integrated color + temporal variance: the moments pass reads
// it, then the à-trous feedback level overwrites it as next frame's history. The denoised output the
// consumer reads is written by the à-trous final level, not here.
layout(set = 1, binding = 7,  rgba16f) uniform writeonly image2D outColor;     // curr color + variance
layout(set = 1, binding = 8,  rgba16f) uniform writeonly image2D outMoments;   // curr (mu1, mu2, histLen)
layout(set = 1, binding = 9,  rgba16f) uniform writeonly image2D outGeom;      // curr (linearZ, octN.x, octN.y)

layout(push_constant) uniform PC {
    float alphaColor;       // steady-state EMA alpha (color)
    float alphaMoments;     // steady-state EMA alpha (moments)
    float historyCap;       // max history length — per-pixel alpha floor = 1/historyCap
    float depthThreshold;   // relative linear-depth disocclusion tolerance
    float normalThreshold;  // min dot(prevN, currN) to accept a tap
    int   gbufferScale;     // 1 = full-res; >1 = working res below the full G-buffer (half-res GI)
    int   dispatchW;        // working (dispatch) resolution — history/noisy/output space
    int   dispatchH;
} pc;

// Map a working-res pixel to the full-res G-buffer texel (depth/normal/motion live at full res).
// gbufferScale==1 is the exact identity for full-res channels.
ivec2 SvgfGuide(ivec2 p) {
    if (pc.gbufferScale == 1) return p;
    vec2  uv   = (vec2(p) + 0.5) / vec2(pc.dispatchW, pc.dispatchH);
    ivec2 full = ivec2(ubo.viewportSize);
    return clamp(ivec2(uv * vec2(full)), ivec2(0), full - 1);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size  = ivec2(pc.dispatchW, pc.dispatchH);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2  octN    = texelFetch(u_CurrNormal, SvgfGuide(pixel), 0).rg;
    vec3  N       = SvgfOctDecode(octN);
    float depth   = texelFetch(u_CurrDepth, SvgfGuide(pixel), 0).r;
    float curLinZ = SvgfLinearizeDepth(depth);

    // Carry this pixel's geometry forward for next frame's disocclusion test (all pixels).
    imageStore(outGeom, pixel, vec4(curLinZ, octN.x, octN.y, 0.0));

    // Sky / background — no DI to accumulate; reset history so a later disocclusion starts clean.
    if (depth >= 1.0) {
        imageStore(outColor,    pixel, vec4(0.0));
        imageStore(outMoments,  pixel, vec4(0.0));
        return;
    }

    // Clamp the HDR signal to f16 range, and clamp the luminance used for the moments so mu2 = lum^2
    // stays inside f16 (65504) — an unclamped bright light overflows to +Inf and poisons the variance
    // channel + the feedback. The variance cap only softens edge-stop strength on very bright pixels.
    vec3  di     = clamp(texelFetch(u_DiIn, pixel, 0).rgb, 0.0, 65504.0);
    float curLum = min(SvgfLuminance(di), 255.0);

    // Reproject (TAA convention: motion is an NDC delta; UV offset = motion * 0.5).
    vec2 uv       = (vec2(pixel) + 0.5) / vec2(size);
    vec2 prevUV   = uv - texelFetch(u_Motion, SvgfGuide(pixel), 0).rg * 0.5;
    vec2 prevPixF = prevUV * vec2(size) - 0.5;   // center the 2x2 footprint on the sample
    ivec2 p0      = ivec2(floor(prevPixF));
    vec2  fr      = prevPixF - vec2(p0);
    float bw[4]   = float[4]((1.0 - fr.x) * (1.0 - fr.y), fr.x * (1.0 - fr.y),
                             (1.0 - fr.x) * fr.y,         fr.x * fr.y);
    ivec2 off[4]  = ivec2[4](ivec2(0, 0), ivec2(1, 0), ivec2(0, 1), ivec2(1, 1));

    vec3  pColor = vec3(0.0);
    vec2  pMom   = vec2(0.0);   // mu1, mu2
    float pHist  = 0.0;
    float sumw   = 0.0;
    bool inBounds = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));
    if (inBounds) {
        for (int i = 0; i < 4; ++i) {
            ivec2 tp = p0 + off[i];
            if (any(lessThan(tp, ivec2(0))) || any(greaterThanEqual(tp, size))) continue;

            vec3  g        = imageLoad(u_GeomPrev, tp).rgb;      // prev (linearZ, octN.x, octN.y)
            float prevLinZ = g.r;
            vec3  prevN    = SvgfOctDecode(g.gb);
            bool  ok = abs(curLinZ - prevLinZ) < pc.depthThreshold * curLinZ
                    && dot(prevN, N) > pc.normalThreshold;
            if (!ok) continue;

            float w = bw[i];
            pColor += w * imageLoad(u_ColorHistPrev, tp).rgb;
            vec3  m = imageLoad(u_MomentsPrev, tp).rgb;          // mu1, mu2, histLen
            pMom   += w * m.rg;
            pHist  += w * m.b;
            sumw   += w;
        }
    }

    float histLen;
    vec3  color;
    vec2  mom;
    if (sumw > 0.01) {
        float inv = 1.0 / sumw;
        pColor *= inv;  pMom *= inv;  pHist *= inv;
        histLen   = min(pc.historyCap, pHist + 1.0);
        float a   = max(pc.alphaColor,   1.0 / histLen);
        float am  = max(pc.alphaMoments, 1.0 / histLen);
        color = mix(pColor, di, a);
        mom   = mix(pMom, vec2(curLum, curLum * curLum), am);
    } else {
        // Disocclusion — discard history, full replace.
        histLen = 1.0;
        color   = di;
        mom     = vec2(curLum, curLum * curLum);
    }

    float variance = mom.y - mom.x * mom.x;
    variance = (isinf(variance) || isnan(variance)) ? 0.0 : max(0.0, variance);
    imageStore(outColor,    pixel, vec4(color, variance));
    imageStore(outMoments,  pixel, vec4(mom, histLen, 0.0));
}
