#version 460

// Slang Phase-0 spike — GPU diff reducer. Compares the GLSL-emitted output image (u_A) against the
// Slang-emitted one (u_B), accumulating a tiny verdict block: the max absolute component difference, the
// max per-component ULP distance, the count of differing pixels, and the count of covered (hit) pixels.
// Read back host-side and logged. Identical compilers => maxUlp 0 + differingPixels 0. see spike #156

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D u_A;   // GLSL reference output
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D u_B;   // Slang port output
layout(std430, set = 0, binding = 2) buffer DiffBlock {
    uint maxAbsDiffBits;    // floatBitsToUint of the max |A-B| component (monotonic for >=0)
    uint differingPixels;   // pixels with any nonzero component diff
    uint maxUlpDiff;        // max per-component ULP distance
    uint coveredPixels;     // pixels where either side rendered non-black (a hit)
} diff;

// ULP distance for non-negative floats: their int bit patterns are monotonic, so the absolute integer
// difference is the count of representable floats between them. Rendered radiance is always >= 0.
uint UlpDiff(float x, float y) {
    int ix = floatBitsToInt(x);
    int iy = floatBitsToInt(y);
    return uint(abs(ix - iy));
}

void main() {
    ivec2 size  = imageSize(u_A);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 a = imageLoad(u_A, pixel).rgb;
    vec3 b = imageLoad(u_B, pixel).rgb;

    vec3  d    = abs(a - b);
    float maxC = max(d.r, max(d.g, d.b));
    uint  ulp  = max(UlpDiff(a.r, b.r), max(UlpDiff(a.g, b.g), UlpDiff(a.b, b.b)));

    if (maxC > 0.0) {
        atomicMax(diff.maxAbsDiffBits, floatBitsToUint(maxC));
        atomicAdd(diff.differingPixels, 1u);
    }
    atomicMax(diff.maxUlpDiff, ulp);
    if (dot(a, a) > 0.0 || dot(b, b) > 0.0)
        atomicAdd(diff.coveredPixels, 1u);
}
