#version 450

// Forward+ cluster AABB builder.
// One invocation per cluster (TILES_X·TILES_Y·SLICES_Z). For each cluster, unprojects the four
// NDC tile corners to view-space rays, computes Olsson logarithmic view-space Z bounds, intersects
// rays with z-planes to get 8 view-space corner points, then writes the AABB. Also zero-clears
// the ClusterGrid SSBO so LightAssignPass atomicAdds start from a known state.

const uint TILES_X  = 16u;
const uint TILES_Y  =  9u;
const uint SLICES_Z = 48u;

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

struct ClusterAABB {
    vec4 minView;  // .xyz view-space min; .w padding for std430 alignment
    vec4 maxView;
};

layout(std430, set = 0, binding = 0) writeonly buffer ClusterAABBBuffer {
    ClusterAABB clusters[];
};

layout(std430, set = 0, binding = 1) writeonly buffer ClusterGridBuffer {
    uvec2 grid[];   // (offset, count) — produced by LightAssignPass; here we just zero-clear
};

layout(push_constant) uniform PC {
    mat4  invProjection;
    vec2  viewportSize;
    vec2  _pad;
    float nearZ;
    float farZ;
    uint  tilesX;
    uint  tilesY;
} pc;

vec3 ScreenToView(vec3 ndc) {
    vec4 v = pc.invProjection * vec4(ndc, 1.0);
    return v.xyz / v.w;
}

vec3 IntersectZPlane(vec3 dir, float zPlane) {
    return dir * (zPlane / dir.z);
}

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint z = gl_GlobalInvocationID.z;
    if (x >= pc.tilesX || y >= pc.tilesY || z >= SLICES_Z) return;

    uint clusterID = z * pc.tilesX * pc.tilesY + y * pc.tilesX + x;

    // NDC tile corners. After the Vulkan Y-flip baked into projection, NDC y still spans [-1, 1];
    // y orientation is irrelevant here since we take min/max of all 8 corners for the AABB.
    vec2 ndcMin = vec2(float(x)     / float(pc.tilesX) * 2.0 - 1.0,
                       float(y)     / float(pc.tilesY) * 2.0 - 1.0);
    vec2 ndcMax = vec2(float(x + 1) / float(pc.tilesX) * 2.0 - 1.0,
                       float(y + 1) / float(pc.tilesY) * 2.0 - 1.0);

    // View-space rays from camera origin through the four tile corners at the near plane.
    vec3 vTL = ScreenToView(vec3(ndcMin.x, ndcMin.y, 0.0));
    vec3 vTR = ScreenToView(vec3(ndcMax.x, ndcMin.y, 0.0));
    vec3 vBL = ScreenToView(vec3(ndcMin.x, ndcMax.y, 0.0));
    vec3 vBR = ScreenToView(vec3(ndcMax.x, ndcMax.y, 0.0));

    // Olsson logarithmic depth slicing — view-space z is negative in a right-handed view frame.
    float zNear = -pc.nearZ * pow(pc.farZ / pc.nearZ, float(z)     / float(SLICES_Z));
    float zFar  = -pc.nearZ * pow(pc.farZ / pc.nearZ, float(z + 1) / float(SLICES_Z));

    vec3 c0 = IntersectZPlane(vTL, zNear);
    vec3 c1 = IntersectZPlane(vTR, zNear);
    vec3 c2 = IntersectZPlane(vBL, zNear);
    vec3 c3 = IntersectZPlane(vBR, zNear);
    vec3 c4 = IntersectZPlane(vTL, zFar);
    vec3 c5 = IntersectZPlane(vTR, zFar);
    vec3 c6 = IntersectZPlane(vBL, zFar);
    vec3 c7 = IntersectZPlane(vBR, zFar);

    vec3 mn = min(min(min(c0, c1), min(c2, c3)), min(min(c4, c5), min(c6, c7)));
    vec3 mx = max(max(max(c0, c1), max(c2, c3)), max(max(c4, c5), max(c6, c7)));

    clusters[clusterID].minView = vec4(mn, 0.0);
    clusters[clusterID].maxView = vec4(mx, 0.0);

    grid[clusterID] = uvec2(0u, 0u);
}
